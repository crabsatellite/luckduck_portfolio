---
import { t, type Lang } from "~/i18n/strings";
import type { Mod } from "~/lib/data";
import { isCredited, hasRegression, hasNoIssues, modVersionMeta, modVersionMetaZh } from "~/lib/data";
import ModLogo from "~/components/ModLogo.astro";

interface Props {
  mod: Mod;
  lang: Lang;
  /** Optional 1-based index for editorial numbering in card grids. */
  index?: number;
}
const { mod, lang, index } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const langPrefix = lang === "en" ? `${base}/en` : base;

const credited = isCredited(mod);
const regress = hasRegression(mod);
const noIssues = hasNoIssues(mod);

const cnName = mod.name_zh.includes("/") ? mod.name_zh.split("/")[0].trim() : mod.name_zh;
const showCn = cnName !== mod.name_en;

const totalRounds = mod.rounds.length;
const versionLine = lang === "zh" ? modVersionMetaZh(mod) : modVersionMeta(mod);
const indexLabel = typeof index === "number" ? String(index).padStart(2, "0") : null;

const roundsLabel = lang === "en"
  ? `${totalRounds} round${totalRounds > 1 ? "s" : ""} on file`
  : `${totalRounds} 轮测试记录`;

const countLabel = noIssues
  ? (lang === "en" ? "clean" : "通过")
  : (lang === "en" ? "bugs filed" : "条 bug");

const overstampText = credited
  ? (lang === "en" ? "verified" : "已署名")
  : noIssues
    ? (lang === "en" ? "clean pass" : "零 bug 通过")
    : null;
const overstampVariant = noIssues ? "ok" : "accent";
---

<article
  class:list={["card", { "card--credited": credited, "card--noissues": noIssues, "card--regression": regress }]}
  data-mc-versions={mod.versions.join(",")}
  data-credited={credited ? "1" : "0"}
  data-regression={regress ? "1" : "0"}
>
  <a href={`${langPrefix}/cases/${mod.id}`} class="card__link" aria-label={`Tester log: ${mod.name_en}`}>
    {credited && <span class="tape" aria-hidden="true"></span>}
    {overstampText && (
      <span class:list={["overstamp", { "overstamp--ok": overstampVariant === "ok" }]} aria-hidden="true">
        {overstampText}
      </span>
    )}
    {indexLabel && (
      <span class="card__index" aria-hidden="true">
        <span class="card__index-prefix">№</span>
        <span class="card__index-num mono tnum">{indexLabel}</span>
      </span>
    )}

    <header class="card__head">
      <div class="card__logo">
        <ModLogo mod={mod} size={56} />
      </div>
      <div class="card__title">
        <h3 class="card__name">{mod.name_en}</h3>
        {showCn && <p class="card__cn">{cnName}</p>}
      </div>
    </header>

    <div class="card__count">
      <span class="card__count-num fancy-num fancy-num--accent mono tnum">{mod.total_bugs}</span>
      <span class="card__count-label">{countLabel}</span>
    </div>

    <div class="card__meta">
      <span class="card__meta-rounds mono tnum">{roundsLabel}</span>
      <span class="card__meta-versions mono tnum">{versionLine}</span>
    </div>

    {(credited || regress || noIssues) && (
      <div class="card__pills">
        {credited && (
          <span class="badge">{t(lang, "credited.badge")} ✓</span>
        )}
        {regress && (
          <span class="pill" data-status="unfixed">{t(lang, "regression.label")}</span>
        )}
        {noIssues && (
          <span class="pill" data-status="fixed">{t(lang, "noissues.label")}</span>
        )}
      </div>
    )}

    {mod.depth_signals.length > 0 && (
      <div class="card__signals">
        {mod.depth_signals.slice(0, 3).map((s) => (
          <span class="chip">{s}</span>
        ))}
        {mod.depth_signals.length > 3 && (
          <span class="chip chip--more">+{mod.depth_signals.length - 3}</span>
        )}
      </div>
    )}

    <span class="card__arrow" aria-hidden="true">
      <span class="card__arrow-label">{lang === "en" ? "open tester log" : "查看测试日志"}</span>
      <span class="card__arrow-glyph">→</span>
    </span>
  </a>
</article>

<style>
  .card {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
    box-shadow:
      0 1px 0 color-mix(in oklch, var(--accent-deep) 14%, transparent),
      0 18px 32px -22px rgba(0, 0, 0, 0.55),
      0 2px 6px -2px rgba(0, 0, 0, 0.18);
  }
  @media (prefers-color-scheme: light) {
    .card {
      box-shadow:
        0 1px 0 color-mix(in oklch, var(--accent-deep) 18%, transparent),
        0 16px 28px -22px rgba(80, 60, 30, 0.32),
        0 2px 6px -2px rgba(80, 60, 30, 0.14);
    }
  }
  .card:hover,
  .card:focus-within {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow:
      0 1px 0 var(--accent-deep),
      0 26px 38px -22px rgba(0, 0, 0, 0.7),
      0 4px 12px -2px color-mix(in oklch, var(--accent) 24%, transparent);
  }
  .card--noissues:hover { border-color: var(--ok); }
  .card--noissues:hover { box-shadow: 0 1px 0 var(--ok-deep), 0 26px 38px -22px rgba(0, 0, 0, 0.7), 0 4px 12px -2px color-mix(in oklch, var(--ok) 24%, transparent); }

  .card__link {
    display: grid;
    grid-template-rows: auto auto auto auto auto 1fr auto;
    gap: 0.85rem;
    color: inherit;
    text-decoration: none;
    height: 100%;
    position: relative;
    padding: 1.6rem 1.4rem 1.3rem 1.4rem;
    isolation: isolate;
  }

  /* ---- editorial index № at top-left ------------------------ */
  .card__index {
    position: absolute;
    top: 0.85rem;
    left: 1.4rem;
    display: inline-flex;
    align-items: baseline;
    gap: 0.18rem;
    line-height: 1;
    z-index: 2;
  }
  .card__index-prefix {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ink-mute);
    font-size: 0.85rem;
  }
  .card__index-num {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
    color: var(--accent);
    font-size: 1.2rem;
    letter-spacing: 0;
  }

  /* ---- header: logo + name --------------------------------- */
  .card__head {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 0.95rem;
    align-items: center;
    margin-top: 0.4rem;
  }
  .card__logo { line-height: 0; }
  .card__title { min-width: 0; }
  .card__name {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.3rem;
    margin: 0;
    color: var(--ink);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .card__cn {
    font-family: var(--font-cjk);
    font-weight: 400;
    color: var(--ink-soft);
    font-size: 0.92rem;
    margin: 0.2rem 0 0 0;
    line-height: 1.4;
  }

  /* ---- big count block -------------------------------------- */
  .card__count {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.5rem 0 0.65rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    margin-top: 0.3rem;
  }
  .card__count-num {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    line-height: 0.85;
  }
  .card--noissues .card__count-num { color: var(--ok); }
  .card__count-label {
    font-family: var(--font-stamp);
    font-size: 0.95rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
    line-height: 1.2;
  }
  :lang(zh) .card__count-label {
    font-family: var(--font-stamp), var(--font-cjk);
    letter-spacing: 0.06em;
    text-transform: none;
  }

  /* ---- meta line: rounds + versions ------------------------- */
  .card__meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.78rem;
    color: var(--ink-mute);
    line-height: 1.4;
  }
  .card__meta-rounds {
    color: var(--ink);
    font-weight: 500;
    font-family: var(--font-sans);
    letter-spacing: 0;
  }
  :lang(zh) .card__meta-rounds { font-family: var(--font-cjk); }
  .card__meta-versions {
    color: var(--ink-mute);
    font-size: 0.74rem;
  }

  /* ---- pills + signals -------------------------------------- */
  .card__pills,
  .card__signals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .chip--more {
    background: transparent;
    color: var(--ink-mute);
    border-style: dashed;
  }

  /* ---- card foot: arrow on click hint ----------------------- */
  .card__arrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding-top: 0.8rem;
    border-top: 1px dotted var(--rule);
    font-family: var(--font-sans);
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 600;
    margin-top: auto;
  }
  :lang(zh) .card__arrow { font-family: var(--font-cjk); }
  .card__arrow-label {
    letter-spacing: 0.02em;
  }
  .card__arrow-glyph {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    transition: transform 160ms ease;
  }
  .card__link:hover .card__arrow-glyph,
  .card__link:focus-visible .card__arrow-glyph {
    transform: translateX(4px);
  }

  /* ---- overstamp positioning -------------------------------- */
  .overstamp {
    top: 1rem;
    right: 1rem;
  }
</style>
