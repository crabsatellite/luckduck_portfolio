---
import { t, type Lang } from "~/i18n/strings";
import type { Mod } from "~/lib/data";
import { isCredited, hasRegression, hasNoIssues, modVersionMeta, modVersionMetaZh } from "~/lib/data";
import ModLogo from "~/components/ModLogo.astro";

interface Props {
  mod: Mod;
  lang: Lang;
}
const { mod, lang } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const langPrefix = lang === "en" ? `${base}/en` : base;

const credited = isCredited(mod);
const regress = hasRegression(mod);
const noIssues = hasNoIssues(mod);

const cnName = mod.name_zh.includes("/") ? mod.name_zh.split("/")[0].trim() : mod.name_zh;
const showCn = cnName !== mod.name_en;

const totalRounds = mod.rounds.length;
const versionLine = lang === "zh" ? modVersionMetaZh(mod) : modVersionMeta(mod);
---

<article
  class:list={["card", { "card--credited": credited, "card--noissues": noIssues, "card--regression": regress }]}
  data-mc-versions={mod.versions.join(",")}
  data-credited={credited ? "1" : "0"}
  data-regression={regress ? "1" : "0"}
>
  <a href={`${langPrefix}/cases/${mod.id}`} class="card__link" aria-label={`Tester log: ${mod.name_en}`}>
    <span class="card__stripe" aria-hidden="true"></span>
    <div class="card__inner">
      <div class="card__head">
        <ModLogo mod={mod} size={64} />
        <div class="card__title">
          <h3 class="card__name">{mod.name_en}</h3>
          {showCn && <p class="card__cn" aria-hidden="true">{cnName}</p>}
          <p class="card__meta mono tnum">{versionLine}</p>
        </div>
        <div class="card__count">
          <span class="card__count-num mono tnum">{mod.total_bugs}</span>
          <span class="card__count-label">
            {noIssues ? (lang === "en" ? "clean" : "通过") : (lang === "en" ? "bugs" : "条 bug")}
          </span>
        </div>
      </div>

      <div class="card__rounds mono">
        {totalRounds} {lang === "en"
          ? "round" + (totalRounds > 1 ? "s" : "")
          : "个测试轮次"}
      </div>

      {(credited || regress || noIssues) && (
        <div class="card__pills">
          {credited && (
            <span class="badge">{t(lang, "credited.badge")} ✓</span>
          )}
          {regress && (
            <span class="pill" data-status="unfixed">{t(lang, "regression.label")}</span>
          )}
          {noIssues && (
            <span class="pill" data-status="fixed">{t(lang, "noissues.label")}</span>
          )}
        </div>
      )}

      {mod.depth_signals.length > 0 && (
        <div class="card__signals">
          {mod.depth_signals.slice(0, 4).map((s) => (
            <span class="chip">{s}</span>
          ))}
          {mod.depth_signals.length > 4 && (
            <span class="chip">+{mod.depth_signals.length - 4}</span>
          )}
        </div>
      )}
    </div>
  </a>
</article>

<style>
  .card {
    position: relative;
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 160ms ease;
  }
  .card:hover {
    border-color: var(--accent);
  }
  .card__link {
    display: block;
    color: inherit;
    text-decoration: none;
    height: 100%;
    position: relative;
  }
  .card__stripe {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 6px;
    background: var(--accent);
    transition: width 140ms ease;
  }
  .card--noissues .card__stripe { background: var(--ok); }
  .card__link:hover .card__stripe,
  .card__link:focus-visible .card__stripe { width: 9px; }
  .card__inner {
    padding: 1.2rem 1.2rem 1.2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .card__head {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: 1rem;
    align-items: flex-start;
  }
  .card__title { min-width: 0; }
  .card__name {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.15rem;
    margin: 0;
    color: var(--ink);
    line-height: 1.2;
  }
  .card__cn {
    font-family: var(--font-cjk);
    font-weight: 500;
    color: var(--ink-soft);
    font-size: 0.85rem;
    margin: 0.18rem 0 0 0;
  }
  .card__meta {
    font-size: 0.74rem;
    color: var(--ink-mute);
    margin: 0.35rem 0 0 0;
    letter-spacing: 0.01em;
    line-height: 1.45;
  }
  .card__count {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    padding: 0.5rem 0.8rem;
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    min-width: 4.6rem;
  }
  .card__count-num {
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--accent);
    line-height: 1;
  }
  .card--noissues .card__count-num { color: var(--ok); }
  .card__count-label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    color: var(--ink-mute);
    letter-spacing: 0.04em;
  }
  :lang(zh) .card__count-label { font-family: var(--font-cjk); letter-spacing: 0.06em; }
  .card__rounds {
    font-size: 0.8rem;
    color: var(--ink-mute);
    letter-spacing: 0.02em;
  }
  .card__pills, .card__signals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
