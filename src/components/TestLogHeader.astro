---
import { t, type Lang } from "~/i18n/strings";
import { modEmoji, type Mod } from "~/lib/data";

interface Props {
  mod: Mod;
  logNo: string;
  totalBugs: number;
  hasRegression: boolean;
  isCredited: boolean;
  hasNoIssues: boolean;
  lang: Lang;
}
const {
  mod, logNo, totalBugs, hasRegression, isCredited, hasNoIssues, lang,
} = Astro.props;

const cnName = mod.name_zh.includes("/") ? mod.name_zh.split("/")[0].trim() : mod.name_zh;
const showCn = cnName !== mod.name_en;
const emoji = modEmoji(mod);
---

<header class="tlh">
  <div class="tlh__top">
    <p class="eyebrow"><strong>{t(lang, "case.eyebrow")}</strong> #{logNo}</p>
    <div class="tlh__pills">
      {isCredited && <span class="badge">{t(lang, "credited.badge")} ✓</span>}
      {hasRegression && <span class="pill" data-status="unfixed">{t(lang, "regression.label")}</span>}
      {hasNoIssues && <span class="pill" data-status="fixed">{t(lang, "noissues.label")}</span>}
    </div>
  </div>
  <div class="tlh__body">
    <div class="tlh__icon" aria-hidden="true">{emoji}</div>
    <div class="tlh__title">
      <h1 class="tlh__name h-display">{mod.name_en}</h1>
      {showCn && <p class="tlh__cn" aria-hidden="true">{cnName}</p>}
      <p class="tlh__meta mono tnum">
        MC {mod.versions.join(" / ")}
        <span class="tlh__sep" aria-hidden="true"> · </span>
        <span class="tlh__bugcount">{totalBugs}</span>
        {" "}{lang === "en" ? "bugs filed" : "条 bug"}
      </p>
    </div>
  </div>
</header>

<style>
  .tlh { padding: 1.2rem 0 1.4rem 0; }
  .tlh__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }
  .tlh__pills { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tlh__body {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 1.2rem;
    align-items: center;
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    border-left: 6px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: 1.2rem 1.4rem;
  }
  @media (max-width: 540px) {
    .tlh__body { grid-template-columns: 1fr; gap: 0.6rem; padding: 1rem; }
  }
  .tlh__icon {
    width: 88px;
    height: 88px;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.4rem;
    line-height: 1;
  }
  .tlh__name {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    margin: 0;
    color: var(--ink);
  }
  .tlh__cn {
    font-family: var(--font-cjk);
    font-weight: 500;
    color: var(--ink-soft);
    font-size: clamp(0.95rem, 1.6vw, 1.15rem);
    margin: 0.3rem 0 0 0;
  }
  .tlh__meta {
    margin: 0.5rem 0 0 0;
    font-size: 0.85rem;
    color: var(--ink-mute);
    letter-spacing: 0.02em;
  }
  .tlh__bugcount {
    font-weight: 700;
    color: var(--accent);
    font-size: 1.05rem;
  }
  .tlh__sep { opacity: 0.5; }
</style>
