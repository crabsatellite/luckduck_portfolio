---
// Per-mod test-log header: kicker + log number on the left, mod
// name as the italic-serif display title in the middle, oversized
// bug-count counter (or clean-pass marker) on the right. Closed by
// a thin diamond rule.
import { t, type Lang } from "~/i18n/strings";
import {
  formatVerifiedDate,
  liveTesterForMod,
  modVersionMeta,
  modVersionMetaZh,
  type Mod,
} from "~/lib/data";
import ModLogo from "~/components/ModLogo.astro";

interface Props {
  mod: Mod;
  logNo: string;
  totalBugs: number;
  hasRegression: boolean;
  isCredited: boolean;
  hasNoIssues: boolean;
  lang: Lang;
}
const {
  mod, logNo, totalBugs, hasRegression, isCredited, hasNoIssues, lang,
} = Astro.props;

const cnName = mod.name_zh.includes("/") ? mod.name_zh.split("/")[0].trim() : mod.name_zh;
const showCn = cnName !== mod.name_en;
const versionLine = lang === "zh" ? modVersionMetaZh(mod) : modVersionMeta(mod);

const bugsLabel = hasNoIssues
  ? t(lang, "case.bugs_label_zero")
  : t(lang, "case.bugs_label_plural");

const live = isCredited ? liveTesterForMod(mod) : null;
const liveDate = formatVerifiedDate(live?.snapshot_at ?? null);
const liveStatus: "ok" | "unverified" | "missing" | "stale" | "error" | "skipped" | null =
  live?.status ?? null;
const liveBadgeText: string | null = (() => {
  if (!live || !liveStatus) return null;
  if (liveStatus === "ok" && live.verified && liveDate) {
    return `${t(lang, "credited.live_verified_prefix")} ${liveDate}`;
  }
  if (liveStatus === "unverified" || liveStatus === "stale") {
    return t(lang, "credited.live_unverified");
  }
  if (liveStatus === "missing") {
    return t(lang, "credited.live_missing");
  }
  return null;
})();
const liveBadgeTone: "ok" | "warn" | null = (() => {
  if (!live) return null;
  if (live.status === "ok" && live.verified) return "ok";
  if (live.status === "missing" || live.status === "unverified" || live.status === "stale") return "warn";
  return null;
})();
---

<header class="tlh">
  <div class="tlh__grid">
    <!-- ===== Left rail: department mark + log number ====== -->
    <div class="tlh__rail" aria-hidden="true">
      <span class="tlh__kicker">{t(lang, "case.feature_kicker")}</span>
      <span class="tlh__mark fancy-num fancy-num--accent">№{logNo}</span>
      <span class="tlh__byline">
        <span class="tlh__byline-prefix">{t(lang, "case.byline_prefix")}</span>
        <span class="tlh__byline-name">LUCK666DUCK</span>
      </span>
    </div>

    <!-- ===== Main: title + meta + status pills ============ -->
    <div class="tlh__main">
      <div class="tlh__pills">
        {isCredited && <span class="badge">{t(lang, "credited.badge")} ✓</span>}
        {liveBadgeText && (
          <a
            class:list={["tlh__live-pill", `tlh__live-pill--${liveBadgeTone ?? "warn"}`]}
            href={live?.snapshot_url ?? "#"}
            rel="noopener nofollow"
            target="_blank"
            aria-label={`Wayback verification source for ${mod.name_en}`}
          >
            {liveBadgeText}
          </a>
        )}
        {hasRegression && <span class="pill" data-status="unfixed">{t(lang, "regression.label")}</span>}
        {hasNoIssues && <span class="pill" data-status="fixed">{t(lang, "noissues.label")}</span>}
      </div>

      <div class="tlh__title-row">
        <div class="tlh__icon">
          <ModLogo mod={mod} size={72} />
        </div>
        <div class="tlh__title-wrap">
          <h1 class="tlh__name">{mod.name_en}</h1>
          {showCn && <p class="tlh__cn">{cnName}</p>}
        </div>
      </div>

      <p class="tlh__meta mono tnum">{versionLine}</p>
      <p class="tlh__byline-meta caption">{t(lang, "case.byline_issue")}</p>
    </div>

    <!-- ===== Right: oversized bug counter ================= -->
    <aside class={`tlh__counter ${hasNoIssues ? "tlh__counter--clean" : ""}`} aria-label="bug count">
      <span class="tlh__counter-eyebrow dateline">
        {hasNoIssues ? (lang === "en" ? "clean pass" : "零 bug 通过") : (lang === "en" ? "filed" : "已记录")}
      </span>
      <span class={`tlh__counter-num fancy-num mono tnum ${hasNoIssues ? "fancy-num--ok" : "fancy-num--accent"}`}>
        {totalBugs}
      </span>
      <span class="tlh__counter-label">{bugsLabel}</span>
    </aside>
  </div>

  <!-- ===== Closing diamond rule, mirrors the PageHead ===== -->
  <div class="tlh__close" aria-hidden="true">
    <span class="tlh__close-bullet">◆</span>
    <span class="tlh__close-line"></span>
    <span class="tlh__close-bullet">◆</span>
  </div>
</header>

<style>
  .tlh {
    padding: clamp(1.4rem, 3.4vw, 2.2rem) 0 clamp(0.9rem, 1.8vw, 1.4rem) 0;
    margin-bottom: clamp(1.4rem, 3vw, 2rem);
  }

  /* ---- Main grid ----------------------------------------- */
  .tlh__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.32fr) minmax(0, 1fr) minmax(220px, 0.42fr);
    gap: clamp(1.2rem, 3vw, 2.4rem);
    align-items: start;
    padding-top: clamp(1.2rem, 2.5vw, 1.8rem);
    padding-bottom: clamp(1.4rem, 3vw, 2rem);
    border-top: 3px solid var(--ink);
  }

  /* ---- Rail ---------------------------------------------- */
  .tlh__rail {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-right: clamp(0.6rem, 1.8vw, 1.3rem);
    border-right: 1px dotted var(--rule);
  }
  .tlh__kicker {
    font-family: var(--font-stamp);
    font-size: 0.9rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
    line-height: 1;
  }
  :lang(zh) .tlh__kicker {
    font-family: var(--font-stamp), var(--font-cjk);
    letter-spacing: 0.06em;
    text-transform: none;
  }
  .tlh__mark {
    font-size: clamp(2.6rem, 5.4vw, 4rem);
    line-height: 0.82;
    letter-spacing: -0.025em;
  }
  .tlh__byline {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.35rem;
    line-height: 1.2;
  }
  .tlh__byline-prefix {
    font-family: var(--font-stamp);
    color: var(--ink-mute);
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  :lang(zh) .tlh__byline-prefix {
    font-family: var(--font-stamp), var(--font-cjk);
    letter-spacing: 0.06em;
    text-transform: none;
    font-size: 0.8rem;
  }
  .tlh__byline-name {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--ink);
    letter-spacing: 0.01em;
  }

  /* ---- Main column ---------------------------------------- */
  .tlh__main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .tlh__pills {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
    align-items: center;
  }
  /* Wayback live-verification chip — small, dated proof attached to
     the static verified-tester badge. Clickable, points at the
     archived snapshot used to verify membership. */
  .tlh__live-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: var(--bg-soft);
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    line-height: 1.2;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }
  :lang(zh) .tlh__live-pill {
    font-family: var(--font-mono), var(--font-cjk);
  }
  .tlh__live-pill::before {
    content: "↗";
    font-size: 0.78rem;
    color: var(--ink-fade, var(--ink-mute));
    transition: transform 160ms ease, color 160ms ease;
  }
  .tlh__live-pill:hover,
  .tlh__live-pill:focus-visible {
    color: var(--ink);
    border-color: var(--ink);
    outline: 0;
  }
  .tlh__live-pill:hover::before,
  .tlh__live-pill:focus-visible::before {
    transform: translate(2px, -2px);
  }
  .tlh__live-pill--ok {
    color: var(--ok);
    border-color: color-mix(in oklch, var(--ok) 50%, var(--rule));
    background: color-mix(in oklch, var(--ok) 8%, var(--bg-soft));
  }
  .tlh__live-pill--ok::before { color: var(--ok); }
  .tlh__live-pill--ok:hover,
  .tlh__live-pill--ok:focus-visible {
    color: var(--ok-deep, var(--ok));
    border-color: var(--ok);
    background: color-mix(in oklch, var(--ok) 14%, var(--bg-soft));
  }
  .tlh__live-pill--warn {
    color: var(--accent);
    border-color: color-mix(in oklch, var(--accent) 40%, var(--rule));
    background: color-mix(in oklch, var(--accent) 6%, var(--bg-soft));
  }
  .tlh__live-pill--warn::before { color: var(--accent); }
  .tlh__title-row {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 1rem;
    align-items: center;
    margin-top: 0.2rem;
  }
  .tlh__icon {
    line-height: 0;
    padding: 4px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: color-mix(in oklch, var(--accent) 6%, var(--bg-soft));
  }
  .tlh__title-wrap { min-width: 0; }
  .tlh__name {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.85rem, 4.4vw, 3.2rem);
    line-height: 1.04;
    letter-spacing: -0.018em;
    color: var(--ink);
  }
  .tlh__cn {
    margin: 0.32rem 0 0 0;
    font-family: var(--font-cjk);
    font-weight: 500;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.35;
  }
  .tlh__meta {
    margin: 0;
    font-size: 0.84rem;
    color: var(--ink-mute);
    line-height: 1.5;
  }
  .tlh__byline-meta {
    margin: 0;
    color: var(--ink-mute);
    font-size: 0.84rem;
  }

  /* ---- Counter ------------------------------------------- */
  .tlh__counter {
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-top: 4px solid var(--accent);
    padding: 0.9rem 1.1rem 1.05rem 1.1rem;
    display: grid;
    grid-template-rows: auto auto auto;
    gap: 0.4rem;
    box-shadow:
      6px 6px 0 color-mix(in oklch, var(--accent) 75%, transparent),
      0 0 0 1px color-mix(in oklch, var(--ink) 30%, transparent);
    align-self: start;
  }
  .tlh__counter--clean {
    border-top-color: var(--ok);
    box-shadow:
      6px 6px 0 color-mix(in oklch, var(--ok) 70%, transparent),
      0 0 0 1px color-mix(in oklch, var(--ink) 30%, transparent);
  }
  .tlh__counter-eyebrow {
    color: var(--ink-mute);
    font-size: 0.76rem;
    letter-spacing: 0.18em;
    line-height: 1;
  }
  :lang(zh) .tlh__counter-eyebrow { letter-spacing: 0.08em; }
  .tlh__counter--clean .tlh__counter-eyebrow {
    color: var(--ok);
    font-weight: 600;
  }
  .tlh__counter-num {
    font-size: clamp(3rem, 6.5vw, 4.6rem);
    line-height: 0.85;
  }
  .tlh__counter-label {
    font-family: var(--font-stamp);
    font-size: 0.84rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
    line-height: 1.3;
  }
  :lang(zh) .tlh__counter-label {
    font-family: var(--font-stamp), var(--font-cjk);
    letter-spacing: 0.04em;
    text-transform: none;
    font-size: 0.88rem;
  }

  /* ---- Closing diamond rule ----------------------------- */
  .tlh__close {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding-top: clamp(0.6rem, 1.5vw, 1rem);
  }
  .tlh__close-bullet { color: var(--accent); font-size: 0.7rem; }
  .tlh__close-line { flex: 1; height: 0; border-top: 1px solid var(--rule); }

  /* ---- Responsive --------------------------------------- */
  @media (max-width: 960px) {
    .tlh__grid {
      grid-template-columns: minmax(0, 0.34fr) minmax(0, 1fr);
      gap: 1.4rem;
    }
    .tlh__counter {
      grid-column: 1 / -1;
      grid-row: 2;
      align-self: stretch;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 1rem;
      padding: 0.85rem 1.2rem;
    }
    .tlh__counter-eyebrow { order: 1; }
    .tlh__counter-num { order: 2; flex: 0 0 auto; font-size: 2.6rem; }
    .tlh__counter-label { order: 3; flex: 1; }
  }
  @media (max-width: 640px) {
    .tlh__grid { grid-template-columns: 1fr; }
    .tlh__rail {
      flex-direction: row;
      align-items: baseline;
      gap: 0.85rem;
      flex-wrap: wrap;
      border-right: none;
      border-bottom: 1px dotted var(--rule);
      padding-right: 0;
      padding-bottom: 0.7rem;
    }
    .tlh__mark { font-size: 2.4rem; }
    .tlh__byline { flex-direction: row; gap: 0.4rem; margin-top: 0; }
    .tlh__title-row { grid-template-columns: 56px 1fr; gap: 0.7rem; }
    .tlh__counter { flex-direction: column; align-items: flex-start; }
  }
</style>
