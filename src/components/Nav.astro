---
import { t, pathForLang, type Lang } from "~/i18n/strings";
import MascotDuck from "~/components/MascotDuck.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const langPrefix = lang === "en" ? `${base}/en` : base;

const items = [
  { href: `${langPrefix}/`, key: "nav.home" as const, match: "/" },
  { href: `${langPrefix}/cases`, key: "nav.cases" as const, match: "/cases" },
  { href: `${langPrefix}/methodology`, key: "nav.methods" as const, match: "/methodology" },
  { href: `${langPrefix}/notes`, key: "nav.notes" as const, match: "/notes" },
  { href: `${langPrefix}/about`, key: "nav.about" as const, match: "/about" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const otherLang: Lang = lang === "en" ? "zh" : "en";
const otherLangHref = pathForLang(Astro.url.pathname, otherLang, base);
---

<script is:inline>
  // Persist explicit lang choice when user clicks the toggle, so the
  // BaseLayout auto-redirect respects it on future visits.
  document.addEventListener("click", function (e) {
    var t = e.target && e.target.closest && e.target.closest("[data-lang-toggle]");
    if (!t) return;
    try {
      localStorage.setItem("luckduck.lang", t.getAttribute("data-lang-toggle"));
      sessionStorage.setItem("luckduck.lang.checked", "1");
    } catch (_) {}
  });
</script>

<header class="nav">
  <div class="nav__inner container">
    <a href={`${langPrefix}/`} class="nav__logo" aria-label="LUCK666DUCK home">
      <MascotDuck size={28} alt="" />
      <span class="nav__name">LUCK666DUCK</span>
      <span class="nav__role">{t(lang, "hero.role")}</span>
    </a>
    <nav aria-label="Primary" class="nav__primary">
      <ul class="nav__list">
        {items.map((item) => {
          const itemPath = item.href.replace(/\/$/, "") || "/";
          const stripped = itemPath.replace(base, "") || "/";
          const cur = path.replace(base, "") || "/";
          const langStripped = lang === "en" ? (stripped.replace(/^\/en/, "") || "/") : stripped;
          const curLangStripped = lang === "en" ? (cur.replace(/^\/en/, "") || "/") : cur;
          const active =
            (langStripped === "/" && curLangStripped === "/") ||
            (langStripped !== "/" && curLangStripped.startsWith(langStripped));
          return (
            <li>
              <a
                href={item.href}
                class:list={["nav__link", { "nav__link--active": active }]}
                aria-current={active ? "page" : undefined}
              >
                {t(lang, item.key)}
              </a>
            </li>
          );
        })}
        <li class="nav__lang">
          <a
            href={otherLangHref}
            class="nav__link nav__link--lang"
            aria-label={t(lang, "nav.lang_aria")}
            data-lang-toggle={otherLang}
          >
            {t(lang, "nav.lang")}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
    gap: 1.5rem;
  }
  .nav__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-sans);
    line-height: 1;
    min-width: 0;
  }
  .nav__name {
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.005em;
    color: var(--ink);
  }
  .nav__role {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--ink-mute);
    letter-spacing: 0.01em;
  }
  @media (max-width: 720px) {
    .nav__role { display: none; }
  }
  .nav__primary { display: block; }
  .nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    align-items: center;
  }
  .nav__link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 0.3rem 0;
    border-bottom: 2px solid transparent;
    transition: color 120ms, border-color 120ms;
  }
  :lang(zh) .nav__link { font-family: var(--font-cjk); }
  .nav__link:hover, .nav__link:focus-visible {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .nav__link--active {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  .nav__link--lang {
    color: var(--ink-soft);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0.2rem 0.55rem;
    min-width: 2rem;
    text-align: center;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }
  .nav__link--lang:hover, .nav__link--lang:focus-visible {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }
  @media (max-width: 640px) {
    .nav__name { font-size: 0.88rem; }
    .nav__list { gap: 0.75rem; }
    .nav__link { font-size: 0.85rem; }
  }
  @media (max-width: 470px) {
    .nav__inner { align-items: flex-start; flex-direction: column; gap: 0.7rem; }
    .nav__list { gap: 0.8rem; }
  }
</style>
