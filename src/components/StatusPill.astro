---
import type { Lang } from "~/i18n/strings";

interface Props {
  status: "open" | "unfixed" | "fixed" | "noted-not-bug" | null;
  lang: Lang;
}
const { status } = Astro.props;

// All ledger entries are CLOSED reports filed to the mod author.
// We only render a pill when the author has a public response on record:
//   - fixed         → author shipped a fix
//   - unfixed       → carried through a regression round, still not fixed
//   - noted-not-bug → author publicly clarified it's not a bug / by-design
// status === null  → no public response known; render nothing (the row itself
// already attests the report was filed).
if (!status) { /* render nothing */ }

const display = status === "noted-not-bug" ? "noted" : status;
---

{status && (
  <span class="pill" data-status={status} aria-label={`author response: ${status}`}>
    {display}
  </span>
)}
