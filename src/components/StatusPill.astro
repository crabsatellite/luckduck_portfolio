---
import type { Lang } from "~/i18n/strings";

interface Props {
  status: "open" | "unfixed" | "fixed" | "noted-not-bug" | null;
  lang: Lang;
}
const { status } = Astro.props;
const effective = status ?? "open";
const display = effective === "noted-not-bug" ? "noted" : effective;
---

<span class="pill" data-status={effective} aria-label={`status: ${effective}`}>
  {display}
</span>
