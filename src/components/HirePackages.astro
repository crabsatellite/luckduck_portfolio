---
import { t, type Lang } from "~/i18n/strings";
interface Props { lang: Lang; }
const { lang } = Astro.props;

const pkgs = [
  { id: "1", n: "home.hire_pkg1_name", w: "home.hire_pkg1_when", d: "home.hire_pkg1_deliv", t: "home.hire_pkg1_time" },
  { id: "2", n: "home.hire_pkg2_name", w: "home.hire_pkg2_when", d: "home.hire_pkg2_deliv", t: "home.hire_pkg2_time" },
  { id: "3", n: "home.hire_pkg3_name", w: "home.hire_pkg3_when", d: "home.hire_pkg3_deliv", t: "home.hire_pkg3_time" },
] as const;
---

<div class="hire-grid">
  {pkgs.map((p) => (
    <article class="hire-card">
      <header class="hire-card__head">
        <span class="hire-card__num mono">0{p.id}</span>
        <h3 class="hire-card__name">{t(lang, p.n)}</h3>
      </header>
      <p class="hire-card__when">{t(lang, p.w)}</p>
      <p class="hire-card__deliv">{t(lang, p.d)}</p>
      <p class="hire-card__time mono tnum">{t(lang, p.t)}</p>
    </article>
  ))}
</div>

<style>
  .hire-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  @media (max-width: 880px) { .hire-grid { grid-template-columns: 1fr; } }
  .hire-card {
    background: var(--bg);
    padding: 1.4rem 1.4rem 1.6rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .hire-card__head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .hire-card__num {
    font-size: 0.78rem;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .hire-card__name {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.1rem;
    margin: 0;
    color: var(--ink);
    letter-spacing: -0.005em;
  }
  :lang(zh) .hire-card__name { font-family: var(--font-cjk); }
  .hire-card__when {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--ink-mute);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0;
  }
  :lang(zh) .hire-card__when { font-family: var(--font-cjk); letter-spacing: 0.06em; text-transform: none; }
  .hire-card__deliv {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }
  :lang(zh) .hire-card__deliv { font-family: var(--font-cjk); line-height: 1.75; }
  .hire-card__time {
    font-size: 0.78rem;
    color: var(--accent);
    font-weight: 700;
    margin: 0;
    padding-top: 0.6rem;
    border-top: 1px solid var(--rule);
    letter-spacing: 0.04em;
  }
</style>
