---
import { t, type Lang } from "~/i18n/strings";
import { methods, categoryCounts } from "~/lib/data";

interface Props { lang: Lang; }
const { lang } = Astro.props;

const counts = categoryCounts();
const ordered = [...methods].sort((a, b) => (counts[b.category_id] || 0) - (counts[a.category_id] || 0));
---

<section class="methods">
  <div class="methods__list">
    {ordered.map((m) => {
      const count = counts[m.category_id] || 0;
      const summary = lang === "zh" ? m.summary_zh : m.summary_en;
      const name = lang === "zh" ? m.name_zh : m.name_en;
      return (
        <article id={m.id} class="method">
          <div class="method__head">
            <h3 class="method__name h-section">{name}</h3>
            <p class="method__id mono">{m.category_id}</p>
          </div>
          <p class="method__summary">{summary}</p>
          <p class="method__count-row">
            <span class="method__count mono tnum">{count}</span>
            <span class="method__count-label">{t(lang, "methods.col_count")}</span>
          </p>
        </article>
      );
    })}
  </div>
</section>

<style>
  .methods__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .method {
    background: var(--bg);
    padding: 1.3rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .method__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
  }
  .method__name {
    font-size: var(--fs-h3);
    margin: 0;
    color: var(--ink);
  }
  .method__id {
    font-size: 0.7rem;
    color: var(--ink-mute);
    letter-spacing: 0.04em;
    margin: 0;
    flex-shrink: 0;
  }
  .method__summary {
    font-family: var(--font-sans);
    color: var(--ink-soft);
    font-size: var(--fs-meta);
    line-height: 1.7;
    margin: 0;
    flex: 1;
  }
  :lang(zh) .method__summary { font-family: var(--font-cjk); line-height: 1.8; }
  .method__count-row {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--rule);
  }
  .method__count {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--accent);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .method__count-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--ink-mute);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  :lang(zh) .method__count-label { font-family: var(--font-cjk); letter-spacing: 0.06em; }
</style>
