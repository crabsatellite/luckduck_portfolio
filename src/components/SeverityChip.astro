---
import type { Severity } from "~/lib/data";
interface Props { sev: Severity; }
const { sev } = Astro.props;
---
<span class:list={["sev", `sev--${sev.toLowerCase()}`]} aria-label={`severity ${sev}`}>{sev}</span>
<style>
  .sev {
    display: inline-block;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    padding: 0.18rem 0.45rem;
    border-radius: 3px;
    border: 1px solid var(--rule);
    color: var(--ink-soft);
    background: var(--bg-soft);
    line-height: 1;
  }
  .sev--s0 {
    color: var(--alert);
    border-color: var(--alert);
    background: color-mix(in oklch, var(--alert) 14%, var(--bg-soft));
  }
  .sev--s1 {
    color: var(--accent-deep);
    border-color: var(--accent);
    background: color-mix(in oklch, var(--accent) 16%, var(--bg-soft));
  }
  .sev--s2 {
    color: var(--ink-soft);
    border-color: var(--rule);
  }
  .sev--s3 {
    color: var(--ink-mute);
    border-color: var(--rule);
    background: var(--bg-soft);
  }
</style>
