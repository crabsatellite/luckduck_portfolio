---
import { t, type Lang } from "~/i18n/strings";
import { totalBugs, totalRounds, totalRegressionRounds, mods } from "~/lib/data";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const modCount = mods.length;
const bugCount = totalBugs();
const roundCount = totalRounds();
const regCount = totalRegressionRounds();

const cells = [
  {
    value: String(modCount),
    valueAccent: true,
    label: `${t(lang, "stats.mods_label")} ${t(lang, "stats.mods")}`,
  },
  {
    value: `${bugCount}`,
    valueAccent: false,
    label: `${t(lang, "stats.bugs_label")} ${t(lang, "stats.bugs")}`,
  },
  {
    value: String(roundCount),
    valueAccent: false,
    label: `${t(lang, "stats.reports_label")}`,
  },
  {
    value: String(regCount),
    valueAccent: false,
    label: `${t(lang, "stats.regressions")}`,
  },
  {
    value: "1.20.1 / 1.21.1",
    valueAccent: false,
    isString: true,
    label: t(lang, "stats.coverage"),
  },
];
---

<section class="stats" aria-label="coverage stats">
  <div class="container">
    <hr class="hairline" />
    <div class="stats__row">
      {cells.map((c) => (
        <div class="stats__cell">
          <div
            class:list={[
              "stats__value mono tnum",
              { "stats__value--accent": c.valueAccent, "stats__value--str": c.isString },
            ]}
          >
            {c.value}
          </div>
          <div class="stats__label mono">{c.label}</div>
        </div>
      ))}
    </div>
    <hr class="hairline" />
  </div>
</section>

<style>
  .stats { padding: 0.6rem 0 2.2rem 0; }
  .stats__row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.2rem;
    padding: 1.4rem 0;
  }
  @media (max-width: 900px) {
    .stats__row { grid-template-columns: repeat(2, 1fr); gap: 1.6rem 1.2rem; }
  }
  @media (max-width: 480px) {
    .stats__row { grid-template-columns: 1fr; }
  }
  .stats__cell { display: flex; flex-direction: column; gap: 0.4rem; }
  .stats__value {
    font-weight: 700;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .stats__value--accent { color: var(--accent); }
  .stats__value--str {
    font-size: clamp(1.1rem, 1.8vw, 1.5rem);
    letter-spacing: 0.04em;
  }
  .stats__label {
    font-size: 0.72rem;
    color: var(--ink-faint);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
