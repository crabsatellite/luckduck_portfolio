---
import { type Lang } from "~/i18n/strings";
import { notes, isNoteDraft } from "~/lib/data";

interface Props { lang: Lang; limit?: number; }
const { lang, limit } = Astro.props;
const list = limit ? notes.slice(0, limit) : notes;

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const langPrefix = lang === "en" ? `${base}/en` : base;
---

<ul class="notes-list">
  {list.map((n) => {
    const draft = isNoteDraft(n);
    const title = lang === "zh" ? n.title_zh : n.title_en;
    const summary = lang === "zh" ? n.summary_zh : n.summary_en;
    const href = draft ? null : `${langPrefix}/notes/${n.slug}`;
    return (
      <li class:list={["notes-list__item", { "notes-list__item--draft": draft }]}>
        {href ? (
          <a href={href} class="notes-list__link">
            <header class="notes-list__head">
              <h3 class="notes-list__title">{title}</h3>
              <span class="notes-list__date mono tnum">{n.date}</span>
            </header>
            <p class="notes-list__sum">{summary}</p>
            <ul class="notes-list__tags">
              {n.tags.map((t) => <li>{t}</li>)}
            </ul>
          </a>
        ) : (
          <article class="notes-list__static">
            <header class="notes-list__head">
              <h3 class="notes-list__title">{title}</h3>
              <span class="notes-list__date mono">{lang === "zh" ? "草稿" : "draft"}</span>
            </header>
            <p class="notes-list__sum">{summary}</p>
            <ul class="notes-list__tags">
              {n.tags.map((t) => <li>{t}</li>)}
            </ul>
          </article>
        )}
      </li>
    );
  })}
</ul>

<style>
  .notes-list { list-style: none; margin: 0; padding: 0; }
  .notes-list__item {
    border-top: 1px solid var(--rule);
  }
  .notes-list__item:last-child { border-bottom: 1px solid var(--rule); }
  .notes-list__link, .notes-list__static {
    display: block;
    padding: 1.4rem 0;
    text-decoration: none;
    color: inherit;
    transition: background 120ms ease;
  }
  .notes-list__link:hover, .notes-list__link:focus-visible {
    background: var(--bg-soft);
    margin: 0 -1rem;
    padding: 1.4rem 1rem;
  }
  .notes-list__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.55rem;
    flex-wrap: wrap;
  }
  .notes-list__title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.1rem;
    margin: 0;
    color: var(--ink);
    letter-spacing: -0.005em;
    line-height: 1.3;
  }
  :lang(zh) .notes-list__title { font-family: var(--font-cjk); font-weight: 700; }
  .notes-list__link:hover .notes-list__title { color: var(--accent); }
  .notes-list__date {
    font-size: 0.74rem;
    color: var(--ink-mute);
    flex-shrink: 0;
  }
  .notes-list__sum {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0 0 0.6rem 0;
    max-width: 72ch;
  }
  :lang(zh) .notes-list__sum { font-family: var(--font-cjk); line-height: 1.75; }
  .notes-list__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .notes-list__tags li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-mute);
    border: 1px solid var(--rule);
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
  }
  .notes-list__item--draft .notes-list__title { color: var(--ink-mute); font-weight: 500; }
</style>
