---
// Filters for the cases-index grid. Editorial framing: a 'filter'
// dateline kicker on the left, version chips in the middle, and
// boolean toggles on the right. A live count below tells the reader
// how many entries match the current filters.
import { t, type Lang } from "~/i18n/strings";
import { mods } from "~/lib/data";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const totalCount = mods.length;
---

<section class="filters" aria-label="tested-mod filters">
  <header class="filters__head">
    <p class="filters__kicker dateline">{t(lang, "cases.filter_h")}</p>
    <p class="filters__count">
      <span class="filters__count-prefix">{t(lang, "cases.filter_count_prefix")}</span>
      <span class="filters__count-num mono tnum" data-filter-count>{totalCount}</span>
      <span class="filters__count-suffix">/ {totalCount} {t(lang, "cases.filter_count_suffix")}</span>
    </p>
  </header>

  <div class="filters__row">
    <div class="filters__group">
      <span class="filters__label">{t(lang, "cases.filter_version")}</span>
      <button type="button" class="filters__chip filters__chip--active" data-version="all">
        {t(lang, "cases.all")}
      </button>
      <button type="button" class="filters__chip mono" data-version="1.20.1">1.20.1</button>
      <button type="button" class="filters__chip mono" data-version="1.21.1">1.21.1</button>
    </div>
    <div class="filters__group filters__group--toggles">
      <label class="filters__toggle">
        <input type="checkbox" id="filter-credited" />
        <span class="filters__toggle-text">{t(lang, "cases.filter_credited")}</span>
      </label>
      <label class="filters__toggle">
        <input type="checkbox" id="filter-regression" />
        <span class="filters__toggle-text">{t(lang, "cases.filter_regression")}</span>
      </label>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    var versionBtns = document.querySelectorAll(".filters__chip[data-version]");
    var creditedTgl = document.getElementById("filter-credited");
    var regressionTgl = document.getElementById("filter-regression");
    var cards = document.querySelectorAll(".cases-grid .card");
    var countEl = document.querySelector("[data-filter-count]");
    var current = { version: "all", credited: false, regression: false };

    function apply() {
      var shown = 0;
      cards.forEach(function (card) {
        var versions = (card.getAttribute("data-mc-versions") || "").split(",");
        var credited = card.getAttribute("data-credited") === "1";
        var regression = card.getAttribute("data-regression") === "1";
        var matchVer = current.version === "all" || versions.indexOf(current.version) !== -1;
        var matchCred = !current.credited || credited;
        var matchReg = !current.regression || regression;
        var visible = matchVer && matchCred && matchReg;
        card.style.display = visible ? "" : "none";
        if (visible) shown++;
      });
      if (countEl) countEl.textContent = String(shown);
    }

    versionBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        versionBtns.forEach(function (b) { b.classList.remove("filters__chip--active"); });
        btn.classList.add("filters__chip--active");
        current.version = btn.getAttribute("data-version");
        apply();
      });
    });
    if (creditedTgl) creditedTgl.addEventListener("change", function () {
      current.credited = creditedTgl.checked; apply();
    });
    if (regressionTgl) regressionTgl.addEventListener("change", function () {
      current.regression = regressionTgl.checked; apply();
    });
  });
</script>

<style>
  .filters {
    margin: clamp(1.2rem, 3vw, 1.8rem) 0;
    padding: clamp(1rem, 2.4vw, 1.4rem) clamp(1rem, 2.4vw, 1.4rem) clamp(0.9rem, 2vw, 1.2rem) clamp(1rem, 2.4vw, 1.4rem);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--ink);
    border-radius: var(--radius-lg);
    box-shadow:
      0 1px 0 color-mix(in oklch, var(--accent-deep) 14%, transparent),
      0 14px 24px -22px rgba(0, 0, 0, 0.45);
  }
  .filters__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 0.85rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px dotted var(--rule);
  }
  .filters__kicker {
    margin: 0;
    color: var(--accent);
    font-size: 0.92rem;
    letter-spacing: 0.18em;
    line-height: 1;
  }
  :lang(zh) .filters__kicker { letter-spacing: 0.06em; }
  .filters__count {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    color: var(--ink-mute);
    line-height: 1;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }
  :lang(zh) .filters__count { font-family: var(--font-cjk); }
  .filters__count-prefix {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.78rem;
  }
  :lang(zh) .filters__count-prefix {
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.86rem;
  }
  .filters__count-num {
    color: var(--accent);
    font-weight: 700;
    font-size: 1.08rem;
  }
  .filters__count-suffix {
    color: var(--ink-mute);
    font-size: 0.78rem;
  }

  .filters__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.6rem;
    align-items: center;
    justify-content: space-between;
  }
  .filters__group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .filters__group--toggles { gap: 1rem; }
  .filters__label {
    font-family: var(--font-stamp);
    font-size: 0.78rem;
    color: var(--ink-mute);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-right: 0.55rem;
    line-height: 1;
  }
  :lang(zh) .filters__label {
    font-family: var(--font-stamp), var(--font-cjk);
    letter-spacing: 0.06em;
    text-transform: none;
    font-size: 0.86rem;
  }
  .filters__chip {
    padding: 0.4rem 0.85rem;
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: 0.84rem;
    cursor: pointer;
    border-radius: var(--radius-pill);
    transition: all 140ms ease;
    line-height: 1.1;
  }
  :lang(zh) .filters__chip { font-family: var(--font-cjk); }
  .filters__chip.mono {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }
  .filters__chip:hover, .filters__chip:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }
  .filters__chip--active {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
    font-weight: 600;
  }
  .filters__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: var(--ink-soft);
    cursor: pointer;
    user-select: none;
    padding: 0.32rem 0.5rem;
    border-radius: var(--radius);
    transition: background 140ms ease, color 140ms ease;
  }
  :lang(zh) .filters__toggle { font-family: var(--font-cjk); }
  .filters__toggle:hover { background: var(--bg-soft); color: var(--ink); }
  .filters__toggle input {
    accent-color: var(--accent);
    width: 1rem;
    height: 1rem;
  }
  .filters__toggle:has(input:checked) {
    color: var(--accent);
    background: color-mix(in oklch, var(--accent) 12%, transparent);
  }

  @media (max-width: 720px) {
    .filters__row { gap: 0.9rem; }
    .filters__group--toggles { width: 100%; }
  }
</style>
