---
import { t, type Lang } from "~/i18n/strings";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const langPrefix = lang === "en" ? `${base}/en` : base;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <p class="eyebrow"><strong>CASE-FILE</strong> / ACTIVE</p>
    <h1 id="hero-heading" class="hero__name">
      <span class="hero__latin">Tingfeng Yang</span>
      <span class="hero__cn" aria-hidden="true">楊 庭 鳳</span>
      <span class="hero__handle">LUCK666DUCK</span>
    </h1>
    <p class="hero__role">{t(lang, "hero.role")}</p>
    <div class="hero__cta">
      <a href={`${langPrefix}/cases`} class="btn btn--accent">
        {t(lang, "hero.cta_cases")}<span aria-hidden="true">↓</span>
      </a>
      <a href="https://github.com/LUCK666DUCK" target="_blank" rel="noopener" class="btn">
        {t(lang, "hero.cta_contact")}<span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero { padding: 4rem 0 2.6rem 0; }
  .hero__name {
    margin: 1.4rem 0 1.4rem 0;
    line-height: 1.05;
    font-weight: 400;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .hero__latin {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(2.6rem, 7vw, 5rem);
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .hero__cn {
    font-family: var(--font-cjk);
    font-weight: 500;
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    letter-spacing: 0.32em;
    color: var(--ink);
  }
  .hero__handle {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    letter-spacing: 0.18em;
    color: var(--accent);
    margin-top: 0.4rem;
  }
  .hero__role {
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    color: var(--ink-mute);
    max-width: 64ch;
    line-height: 1.6;
    margin: 1.2rem 0 2rem 0;
  }
  :lang(zh) .hero__role { font-family: var(--font-cjk); line-height: 1.85; }
  .hero__cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
