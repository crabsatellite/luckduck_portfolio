---
import SiteHeader from "~/components/SiteHeader.astro";
import { t, tf, type Lang } from "~/i18n/strings";
import { asset, href } from "~/lib/paths";
import { HIGHLIGHTS } from "~/i18n/highlights";
import {
  findEntry, mods, modName, totalBugs, totalRounds, totalRegressionRounds, testedVersions, profile, mergedPRCount,
} from "~/lib/data";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const versions = testedVersions().join(" / ");
const f3 = [
  tf(lang, "f3.versions", { versions }),
  tf(lang, "f3.mods", { n: mods.length }),
  tf(lang, "f3.entries", { n: totalBugs() }),
  tf(lang, "f3.rounds", { n: totalRounds(), r: totalRegressionRounds() }),
  tf(lang, "f3.credits", { cf: profile.curseforge.tester_credits.length, pr: mergedPRCount() }),
];

// In-game chat lines, cycled over the scene: the quoted log entries.
const chat = HIGHLIGHTS.map((h) => {
  const { mod, bug } = findEntry(h.ref);
  return { tag: `${modName(mod, lang)} ${bug.version}`, text: lang === "en" ? h.en : bug.text_zh };
});
---

<section class="hero sky" aria-labelledby="hero-title">
  <img class="hero__moon pixelated" src={asset("art/moon.png")} width="64" height="64" alt="" />
  <SiteHeader lang={lang} />
  <div class="wrap hero__body">
    <div class="hero__copy">
      <h1 id="hero-title" class="px px-48 shadow hero__title">
        <span>{t(lang, "hero.title_1")}</span>
        <span>{t(lang, "hero.title_2")}</span>
      </h1>
      <p class="hero__lead">
        {tf(lang, "hero.lead", { mods: mods.length, entries: totalBugs(), versions })}
      </p>
      <div class="hero__actions">
        <a class="btn btn--gold" href="#contact">{t(lang, "hero.cta_contact")}</a>
        <a class="btn" href={href(lang, "/cases")}>{t(lang, "hero.cta_logs")}</a>
      </div>
    </div>
    <ul class="f3" aria-label="Stats">
      {f3.map((line) => <li class="ui">{line}</li>)}
    </ul>
  </div>
  <div class="hero__ground pixelated" role="img" aria-label={t(lang, "hero.art_alt")}>
    <span class="glow glow--lantern" aria-hidden="true"></span>
    <span class="glow glow--torch" aria-hidden="true"></span>
    <span class="steam" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <ol class="chat" aria-hidden="true" data-chat={JSON.stringify(chat)}></ol>
  </div>
</section>

<script is:inline>
  // Chat lines arrive one at a time and fade, as they do in game.
  (function () {
    var box = document.querySelector(".chat[data-chat]");
    if (!box) return;
    var lines = JSON.parse(box.getAttribute("data-chat"));
    var still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    function add(item) {
      var li = document.createElement("li");
      var who = document.createElement("span");
      who.className = "chat__who";
      who.textContent = "<LUCK666DUCK> ";
      var tag = document.createElement("span");
      tag.className = "chat__tag";
      tag.textContent = "[" + item.tag + "] ";
      li.appendChild(who);
      li.appendChild(tag);
      li.appendChild(document.createTextNode(item.text));
      box.appendChild(li);
      while (box.children.length > 3) box.removeChild(box.firstChild);
    }
    if (still) { add(lines[0]); add(lines[1]); return; }
    var i = 0;
    function next() { add(lines[i % lines.length]); i++; }
    setTimeout(function () { next(); setInterval(next, 4200); }, 1400);
  })();
</script>

<style>
  .hero { overflow: hidden; }
  .hero__moon {
    position: absolute;
    top: 104px;
    right: max(var(--gutter), calc(50% - 560px));
    opacity: 0.92;
  }
  .hero__body {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 40px;
    padding-top: 72px;
    padding-bottom: 24px;
  }
  .hero__title { margin: 0; color: #fff; }
  .hero__title span { display: block; }
  .hero__title span + span { color: var(--gold); }
  .hero__lead {
    margin: 24px 0 0;
    max-width: 37em;
    font-size: 18px;
    line-height: 1.75;
    color: var(--text-2);
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }

  /* The debug-overlay look: right-aligned lines, each on its own grey box. */
  .f3 {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    justify-items: end;
    gap: 2px;
  }
  .f3 li {
    padding: 0 6px;
    color: #e0e0e0;
    background: rgba(80, 80, 80, 0.56);
    text-shadow: var(--u) var(--u) 0 #383838;
    white-space: nowrap;
  }

  /* 1600 x 272 source pixels, shown at 2x (3x on very wide screens) */
  .hero__ground {
    --s: 2;
    height: calc(272px * var(--s));
    margin-top: -16px;
    /* the ground fades into the page colour, not into the sky */
    background:
      var(--img-ground) 50% 0 / calc(1600px * var(--s)) auto no-repeat,
      linear-gradient(to bottom, transparent 0 calc(88px * var(--s)), var(--bg) calc(88px * var(--s)));
  }
  @media (min-width: 1900px) {
    .hero__ground { --s: 3; margin-top: 0; }
  }

  /* Live bits of the scene, placed in source-pixel coordinates of
     ground.png (1600 px wide, centred): x' = 50% + (x - 800) * s. */
  .hero__ground { position: relative; }
  .glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    mix-blend-mode: screen;
    background: radial-gradient(closest-side, rgba(255, 196, 120, 0.2) 0 34%, rgba(255, 196, 120, 0.1) 34% 67%, rgba(255, 196, 120, 0.04) 67% 100%);
  }
  .glow--lantern {
    left: calc(50% + 8px * var(--s));
    top: calc(152px * var(--s));
    width: calc(64px * var(--s));
    height: calc(64px * var(--s));
    transform: translate(-50%, -50%);
  }
  .glow--torch {
    opacity: 0.5;
    left: calc(50% - 24px * var(--s));
    top: calc(70px * var(--s));
    width: calc(28px * var(--s));
    height: calc(28px * var(--s));
    transform: translate(-50%, -50%);
  }
  .steam {
    position: absolute;
    left: calc(50% - 24px * var(--s));
    top: calc(176px * var(--s));
  }
  .steam i {
    position: absolute;
    width: calc(1px * var(--s));
    height: calc(1px * var(--s));
    background: rgba(240, 246, 248, 0.7);
    opacity: 0;
  }
  .steam i:nth-child(2) { left: calc(3px * var(--s)); }
  .steam i:nth-child(3) { left: calc(-3px * var(--s)); }
  .steam i:nth-child(4) { left: calc(1px * var(--s)); }

  .chat {
    position: absolute;
    left: max(var(--gutter), calc(50% - 580px));
    bottom: calc(40px * var(--s));
    width: min(520px, 40%);
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
    font-size: 14px;
    line-height: 22px;
  }
  .chat :global(li) {
    padding: 2px 8px;
    color: #fff;
    background: rgba(0, 0, 0, 0.5);
    text-shadow: 1px 1px 0 #3f3f3f;
    animation: chat-life 12.6s steps(12) forwards;
  }
  .chat :global(.chat__tag) { color: var(--mc-aqua); }

  @keyframes chat-life {
    0%, 75% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes flicker {
    0%, 100% { opacity: 1; }
    9% { opacity: 0.72; }
    12% { opacity: 1; }
    47% { opacity: 0.86; }
    50% { opacity: 1; }
    78% { opacity: 0.64; }
    80% { opacity: 0.9; }
  }
  @keyframes flicker-dim {
    0%, 100% { opacity: 0.5; }
    30% { opacity: 0.35; }
    34% { opacity: 0.5; }
    70% { opacity: 0.4; }
  }
  @keyframes rise {
    0% { opacity: 0; transform: translate(0, 0); }
    15% { opacity: 1; }
    100% { opacity: 0; transform: translate(calc(2px * var(--s)), calc(-28px * var(--s))); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .glow--lantern { animation: flicker 3.2s steps(1) infinite; }
    .glow--torch { animation: flicker-dim 2.6s steps(1) infinite; }
    .steam i { animation: rise 2.8s steps(14) infinite; }
    .steam i:nth-child(2) { animation-delay: 0.7s; }
    .steam i:nth-child(3) { animation-delay: 1.4s; }
    .steam i:nth-child(4) { animation-delay: 2.1s; }
  }
  @media (prefers-reduced-motion: reduce) {
    .chat :global(li) { animation: none; }
  }
  @media (max-width: 860px) {
    .chat { display: none; }
  }

  @media (max-width: 1000px) {
    .hero__title { font-size: 36px; line-height: 48px; text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.55); }
  }
  @media (max-width: 860px) {
    .hero__body { grid-template-columns: minmax(0, 1fr); padding-top: 48px; gap: 32px; }
    .f3 { justify-items: start; }
    .hero__moon { top: 140px; width: 48px; height: 48px; }
  }
  @media (max-width: 640px) {
    .hero__lead { font-size: 16px; }
    .f3 li { white-space: normal; }
    /* narrow screens only see the workshop: drop the empty sky rows above it */
    .hero__ground {
      height: calc(176px * var(--s));
      margin-top: 0;
      background:
        var(--img-ground) 50% calc(-48px * var(--s)) / calc(1600px * var(--s)) auto no-repeat,
        linear-gradient(to bottom, transparent 0 calc(40px * var(--s)), var(--bg) calc(40px * var(--s)));
    }
    .glow--lantern { top: calc(104px * var(--s)); }
    .glow--torch { top: calc(22px * var(--s)); }
    .steam { top: calc(128px * var(--s)); }
    .hero__moon { display: none; }
  }
</style>
