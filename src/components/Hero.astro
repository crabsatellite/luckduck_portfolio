---
import { t, type Lang } from "~/i18n/strings";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section class="hero">
  <div class="container">
    <h1 class="hero__name h-display">LUCK666DUCK</h1>
    <p class="hero__line">
      <span class="hero__role">{t(lang, "hero.role")}</span>
      <span class="hero__sep" aria-hidden="true">·</span>
      <a href="https://github.com/LUCK666DUCK" rel="noopener" target="_blank" class="hero__link">github</a>
      <span class="hero__sep" aria-hidden="true">·</span>
      <a href="https://www.curseforge.com/members/luck666duck" rel="noopener" target="_blank" class="hero__link">curseforge</a>
    </p>
  </div>
</section>

<style>
  .hero {
    padding: 3.5rem 0 2rem 0;
  }
  .hero__name {
    font-size: clamp(2rem, 5.2vw, 3rem);
    margin: 0 0 0.55rem 0;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .hero__line {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--ink-soft);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  :lang(zh) .hero__line { font-family: var(--font-cjk); }
  .hero__role { color: var(--ink-soft); }
  .hero__sep { color: var(--rule); }
  .hero__link {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
    transition: color 120ms, border-color 120ms;
  }
  .hero__link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
