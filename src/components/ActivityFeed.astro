---
import type { Lang } from "~/i18n/strings";
interface Props { lang: Lang; user?: string; limit?: number; }
const { lang, user = "LUCK666DUCK", limit = 12 } = Astro.props;
---

<div class="feed" data-feed data-user={user} data-limit={limit} data-lang={lang}>
  <ul class="feed__list" data-feed-list>
    <li class="feed__skel"></li>
    <li class="feed__skel"></li>
    <li class="feed__skel"></li>
    <li class="feed__skel"></li>
  </ul>
  <noscript>
    <p class="feed__nojs">
      <a href={`https://github.com/${user}`} rel="noopener" target="_blank">
        github.com/{user} ↗
      </a>
    </p>
  </noscript>
</div>

<script is:inline>
  (function () {
    var roots = document.querySelectorAll("[data-feed]");
    roots.forEach(function (root) {
      var user = root.getAttribute("data-user");
      var limit = parseInt(root.getAttribute("data-limit") || "10", 10);
      var lang = root.getAttribute("data-lang") || "zh";
      var list = root.querySelector("[data-feed-list]");

      var L = lang === "zh"
        ? {
            opened: "提交 issue",
            closed: "关闭 issue",
            reopened: "重开 issue",
            comment: "回复 issue",
            pr_opened: "提交 PR",
            pr_closed: "关闭 PR",
            pr_merged: "合并 PR",
            review: "评审 PR",
            create_repo: "新建 repo",
            create_branch: "新建分支",
            create_tag: "打 tag",
            push: "推送",
            commits: "次提交",
            empty: "最近没有公开活动。直接看",
            empty_link: "GitHub →",
            error: "活动接口暂不可达，",
            error_link: "直接看 GitHub →",
            now: "刚刚",
            min: "分钟前",
            hour: "小时前",
            day: "天前",
            week: "周前",
          }
        : {
            opened: "opened issue",
            closed: "closed issue",
            reopened: "reopened issue",
            comment: "commented on",
            pr_opened: "opened PR",
            pr_closed: "closed PR",
            pr_merged: "merged PR",
            review: "reviewed PR",
            create_repo: "created repo",
            create_branch: "created branch",
            create_tag: "tagged",
            push: "pushed",
            commits: "commits",
            empty: "No recent public activity. See",
            empty_link: "GitHub →",
            error: "Activity feed unreachable, ",
            error_link: "see GitHub directly →",
            now: "just now",
            min: "m ago",
            hour: "h ago",
            day: "d ago",
            week: "w ago",
          };

      function rel(iso) {
        var d = new Date(iso);
        var s = (Date.now() - d.getTime()) / 1000;
        if (s < 60) return L.now;
        if (s < 3600) return Math.floor(s / 60) + (lang === "zh" ? " " : "") + L.min;
        if (s < 86400) return Math.floor(s / 3600) + (lang === "zh" ? " " : "") + L.hour;
        if (s < 604800) return Math.floor(s / 86400) + (lang === "zh" ? " " : "") + L.day;
        if (s < 2592000) return Math.floor(s / 604800) + (lang === "zh" ? " " : "") + L.week;
        return d.toISOString().slice(0, 10);
      }

      function esc(s) {
        return String(s).replace(/[&<>"']/g, function (c) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
        });
      }

      function renderEvent(e) {
        var date = rel(e.created_at);
        var repo = e.repo && e.repo.name ? e.repo.name : "";
        var repoHref = "https://github.com/" + repo;
        var action = "";
        var titleHTML = "";
        var titleHref = repoHref;

        switch (e.type) {
          case "IssuesEvent":
            action = e.payload.action === "opened" ? L.opened
              : e.payload.action === "closed" ? L.closed
              : e.payload.action === "reopened" ? L.reopened : L.opened;
            titleHTML = esc(e.payload.issue.title);
            titleHref = e.payload.issue.html_url;
            break;
          case "IssueCommentEvent":
            action = L.comment;
            titleHTML = esc(e.payload.issue.title);
            titleHref = e.payload.comment.html_url;
            break;
          case "PullRequestEvent":
            action = e.payload.action === "opened" ? L.pr_opened
              : e.payload.pull_request && e.payload.pull_request.merged ? L.pr_merged
              : L.pr_closed;
            titleHTML = esc(e.payload.pull_request.title);
            titleHref = e.payload.pull_request.html_url;
            break;
          case "PullRequestReviewCommentEvent":
            action = L.review;
            titleHTML = esc(e.payload.pull_request.title);
            titleHref = e.payload.comment.html_url;
            break;
          case "CreateEvent":
            if (e.payload.ref_type === "repository") {
              action = L.create_repo;
              titleHTML = "";
            } else if (e.payload.ref_type === "branch") {
              action = L.create_branch;
              titleHTML = "<code>" + esc(e.payload.ref) + "</code>";
            } else if (e.payload.ref_type === "tag") {
              action = L.create_tag;
              titleHTML = "<code>" + esc(e.payload.ref) + "</code>";
            } else { return ""; }
            break;
          case "PushEvent":
            var n = e.payload.size || 0;
            if (n === 0) return "";
            action = L.push + " " + n + " " + L.commits;
            var head = e.payload.commits && e.payload.commits[e.payload.commits.length - 1];
            if (head) {
              titleHTML = esc(head.message.split("\n")[0]);
              titleHref = "https://github.com/" + repo + "/commit/" + head.sha;
            }
            break;
          default:
            return "";
        }

        return (
          '<li class="feed__item">' +
            '<span class="feed__date mono tnum">' + esc(date) + "</span>" +
            '<span class="feed__action">' + esc(action) + "</span>" +
            '<a class="feed__repo mono" href="' + esc(repoHref) + '" rel="noopener" target="_blank">' + esc(repo) + "</a>" +
            (titleHTML
              ? '<a class="feed__title" href="' + esc(titleHref) + '" rel="noopener" target="_blank">' + titleHTML + "</a>"
              : "") +
          "</li>"
        );
      }

      var allowed = {
        IssuesEvent: 1,
        IssueCommentEvent: 1,
        PullRequestEvent: 1,
        PullRequestReviewCommentEvent: 1,
        CreateEvent: 1,
        PushEvent: 1,
      };

      fetch("https://api.github.com/users/" + user + "/events/public?per_page=30", {
        headers: { Accept: "application/vnd.github+json" }
      })
        .then(function (r) { if (!r.ok) throw new Error("status " + r.status); return r.json(); })
        .then(function (events) {
          if (!Array.isArray(events)) throw new Error("bad payload");
          var rows = events
            .filter(function (e) { return allowed[e.type]; })
            .map(renderEvent)
            .filter(function (s) { return s; })
            .slice(0, limit);
          if (rows.length === 0) {
            list.innerHTML =
              '<li class="feed__empty">' + esc(L.empty) +
              ' <a href="https://github.com/' + esc(user) + '" rel="noopener" target="_blank">' + esc(L.empty_link) + "</a></li>";
            return;
          }
          list.innerHTML = rows.join("");
        })
        .catch(function () {
          list.innerHTML =
            '<li class="feed__error">' + esc(L.error) +
            '<a href="https://github.com/' + esc(user) + '" rel="noopener" target="_blank">' + esc(L.error_link) + "</a></li>";
        });
    });
  })();
</script>

<style>
  .feed { font-family: var(--font-sans); }
  :lang(zh) .feed { font-family: var(--font-cjk); }
  .feed__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .feed__skel {
    height: 1.4rem;
    margin-bottom: 0.6rem;
    background: linear-gradient(90deg, var(--bg-soft) 0%, var(--bg-raised) 50%, var(--bg-soft) 100%);
    background-size: 200% 100%;
    animation: feed-skel 1.4s ease-in-out infinite;
    border-radius: 3px;
  }
  @keyframes feed-skel { 0%{background-position:200% 0} 100%{background-position:-200% 0} }

  .feed__item {
    display: grid;
    grid-template-columns: 6.5rem auto 1fr;
    grid-template-rows: auto auto;
    gap: 0.1rem 0.7rem;
    padding: 0.55rem 0;
    border-bottom: 1px dotted var(--rule);
    font-size: 0.88rem;
    line-height: 1.45;
  }
  .feed__item:last-child { border-bottom: 0; }
  @media (max-width: 600px) {
    .feed__item { grid-template-columns: 5rem 1fr; }
    .feed__repo, .feed__title { grid-column: 1 / -1; }
  }
  .feed__date {
    color: var(--ink-mute);
    font-size: 0.78rem;
    grid-row: 1 / 3;
    align-self: center;
  }
  .feed__action {
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .feed__repo {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.78rem;
    grid-column: 3 / 4;
    grid-row: 1;
    align-self: baseline;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .feed__repo:hover { text-decoration: underline; }
  .feed__title {
    color: var(--ink);
    text-decoration: none;
    grid-column: 2 / 4;
    grid-row: 2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    border-bottom: 1px solid transparent;
  }
  .feed__title:hover { border-bottom-color: var(--ink-mute); }
  .feed__title code {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    background: var(--bg-soft);
    padding: 0 0.3em;
    border-radius: 2px;
  }
  .feed__empty, .feed__error, .feed__nojs {
    padding: 0.6rem 0;
    color: var(--ink-mute);
    font-size: 0.88rem;
  }
  .feed__empty a, .feed__error a, .feed__nojs a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
</style>
