---
import type { Lang } from "~/i18n/strings";
import { deliverables } from "~/lib/data";
interface Props { lang: Lang; }
const { lang } = Astro.props;
---

<ul class="deliv">
  {deliverables.map((d) => {
    const name = lang === "zh" ? d.name_zh : d.name_en;
    const desc = lang === "zh" ? d.desc_zh : d.desc_en;
    const href = `https://github.com/${d.slug}`;
    return (
      <li class="deliv__item">
        <a href={href} class="deliv__link" rel="noopener" target="_blank">
          <span class="deliv__head">
            <span class="deliv__name">{name}</span>
            <span class:list={["deliv__status", `deliv__status--${d.status}`]}>{d.status}</span>
          </span>
          <span class="deliv__slug mono">{d.slug}</span>
          <span class="deliv__desc">{desc}</span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .deliv { list-style: none; margin: 0; padding: 0; }
  .deliv__item {
    border-bottom: 1px dotted var(--rule);
  }
  .deliv__item:last-child { border-bottom: 0; }
  .deliv__link {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 0.8rem;
    row-gap: 0.15rem;
    padding: 0.7rem 0;
    text-decoration: none;
    color: inherit;
    transition: background 120ms ease;
  }
  .deliv__head {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }
  .deliv__name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
  }
  :lang(zh) .deliv__name { font-family: var(--font-cjk); }
  .deliv__link:hover .deliv__name { color: var(--accent); }
  .deliv__status {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    padding: 0.08rem 0.4rem;
    border-radius: 2px;
    border: 1px solid var(--rule);
    color: var(--ink-mute);
    text-transform: uppercase;
  }
  .deliv__status--wip {
    color: var(--accent-deep);
    border-color: color-mix(in oklch, var(--accent) 40%, var(--rule));
    background: color-mix(in oklch, var(--accent) 10%, var(--bg));
  }
  .deliv__status--soon { color: var(--ink-mute); }
  .deliv__status--live {
    color: var(--ok);
    border-color: var(--ok);
  }
  .deliv__slug {
    grid-column: 2;
    grid-row: 1;
    font-size: 0.74rem;
    color: var(--ink-mute);
    align-self: baseline;
  }
  @media (max-width: 600px) {
    .deliv__link { grid-template-columns: 1fr; }
    .deliv__slug { grid-column: 1; grid-row: 3; }
  }
  .deliv__desc {
    grid-column: 1 / -1;
    grid-row: 2;
    font-family: var(--font-sans);
    color: var(--ink-soft);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  :lang(zh) .deliv__desc { font-family: var(--font-cjk); line-height: 1.65; }
</style>
