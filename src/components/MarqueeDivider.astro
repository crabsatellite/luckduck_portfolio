---
// Editorial section divider. Renders as a "torn-ticket" perforated band
// with the supplied text set in stamp face, sandwiched between two
// dotted rules. Quiet, intentional, and visually distinct from the
// "running banner" idiom — no longer reads as a placeholder marquee.
//
// The `animated` flag still works for the legacy call sites, but it is
// now a slow gentle slide on the running text only (not the whole band).
// `prefers-reduced-motion` always disables the animation.
interface Props {
  text: string;
  tone?: "ink" | "accent" | "mute";
  animated?: boolean;
  size?: "sm" | "md" | "lg";
}
const { text, tone = "ink", animated = false, size = "md" } = Astro.props;
const repeated = Array(animated ? 8 : 4).fill(text).join("  ·  ");
---

<aside
  class:list={[
    "tearstrip",
    `tearstrip--${tone}`,
    `tearstrip--${size}`,
    { "tearstrip--anim": animated },
  ]}
  role="presentation"
  aria-hidden="true"
>
  <span class="tearstrip__bullet tearstrip__bullet--start" aria-hidden="true">◆</span>
  <div class="tearstrip__viewport">
    <div class="tearstrip__track">
      <span class="tearstrip__line">{repeated}</span>
      {animated && <span class="tearstrip__line">{repeated}</span>}
    </div>
  </div>
  <span class="tearstrip__bullet tearstrip__bullet--end" aria-hidden="true">◆</span>
</aside>

<style>
  .tearstrip {
    --strip-pad: 0.55rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.85rem;
    padding: var(--strip-pad) clamp(1rem, 4vw, 2.4rem);
    background: var(--bg-soft);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    position: relative;
    overflow: hidden;
  }
  .tearstrip::before,
  .tearstrip::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 5px;
    background-image: radial-gradient(circle at 4px 50%, var(--bg) 1.4px, transparent 1.7px);
    background-size: 14px 5px;
    background-repeat: repeat-x;
    opacity: 0.7;
    pointer-events: none;
  }
  .tearstrip::before { top: 0; }
  .tearstrip::after { bottom: 0; }
  .tearstrip--sm { --strip-pad: 0.45rem; }
  .tearstrip--lg { --strip-pad: 0.85rem; }

  .tearstrip__viewport {
    overflow: hidden;
    min-width: 0;
  }
  .tearstrip__track {
    display: flex;
    gap: 2.5rem;
    white-space: nowrap;
  }
  .tearstrip__line {
    font-family: var(--font-stamp);
    font-weight: 400;
    font-size: 1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
    flex: 0 0 auto;
    line-height: 1;
  }
  .tearstrip--sm .tearstrip__line { font-size: 0.9rem; letter-spacing: 0.18em; }
  .tearstrip--lg .tearstrip__line { font-size: 1.15rem; letter-spacing: 0.24em; }

  .tearstrip--ink .tearstrip__line { color: var(--ink); }
  .tearstrip--mute .tearstrip__line { color: var(--ink-mute); }
  .tearstrip--accent {
    background: var(--paper);
    border-color: var(--accent);
    border-top-width: 2px;
    border-bottom-width: 2px;
  }
  .tearstrip--accent .tearstrip__line { color: var(--accent); }

  :lang(zh) .tearstrip__line {
    font-family: var(--font-stamp), var(--font-cjk);
    letter-spacing: 0.08em;
    text-transform: none;
  }

  .tearstrip__bullet {
    font-family: var(--font-serif);
    color: var(--accent);
    font-size: 0.7rem;
    line-height: 1;
    opacity: 0.85;
  }
  .tearstrip--accent .tearstrip__bullet { color: var(--accent-deep); }
  .tearstrip--mute .tearstrip__bullet { color: var(--ink-mute); }

  .tearstrip--anim .tearstrip__track {
    animation: tearstrip-scroll 90s linear infinite;
    will-change: transform;
  }
  @keyframes tearstrip-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tearstrip--anim .tearstrip__track { animation: none; }
  }
</style>
