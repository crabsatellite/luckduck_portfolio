---
import { t, type Lang } from "~/i18n/strings";
import {
  type Mod, isCredited, hasRegression, hasNoIssues,
  modVersionMeta, modVersionMetaZh,
  modCategoryBreakdown, methodFor,
} from "~/lib/data";
import ModLogo from "~/components/ModLogo.astro";

interface Props { mod: Mod; lang: Lang; }
const { mod, lang } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const langPrefix = lang === "en" ? `${base}/en` : base;

const credited = isCredited(mod);
const regress = hasRegression(mod);
const noIssues = hasNoIssues(mod);
const cnName = mod.name_zh.includes("/") ? mod.name_zh.split("/")[0].trim() : mod.name_zh;
const showCn = cnName !== mod.name_en;
const versionLine = lang === "zh" ? modVersionMetaZh(mod) : modVersionMeta(mod);
const top3 = modCategoryBreakdown(mod.id).slice(0, 3);
---

<article class:list={["fcase", { "fcase--noissues": noIssues }]}>
  <a href={`${langPrefix}/cases/${mod.id}`} class="fcase__link" aria-label={mod.name_en}>
    <span class="fcase__stripe" aria-hidden="true"></span>
    <div class="fcase__inner">
      <header class="fcase__head">
        <ModLogo mod={mod} size={56} />
        <div class="fcase__title">
          <h3 class="fcase__name">{mod.name_en}</h3>
          {showCn && <p class="fcase__cn">{cnName}</p>}
        </div>
        <div class="fcase__count">
          <span class="fcase__count-num mono tnum">{mod.total_bugs}</span>
          <span class="fcase__count-label">{noIssues ? (lang === "en" ? "clean" : "通过") : (lang === "en" ? "bugs" : "条")}</span>
        </div>
      </header>

      <p class="fcase__meta mono tnum">{versionLine}</p>

      {(credited || regress) && (
        <div class="fcase__pills">
          {credited && <span class="badge">{t(lang, "credited.badge")} ✓</span>}
          {regress && <span class="pill" data-status="unfixed">{t(lang, "regression.label")}</span>}
        </div>
      )}

      {top3.length > 0 && (
        <div class="fcase__methods">
          <p class="fcase__methods-h">{t(lang, "home.case_top_methods")}</p>
          <ul class="fcase__methods-list">
            {top3.map(({ cat, count }) => {
              const m = methodFor(cat);
              const name = m ? (lang === "zh" ? m.name_zh : m.name_en) : cat;
              return (
                <li>
                  <span class="fcase__method-name">{name}</span>
                  <span class="mono tnum fcase__method-n">{count}</span>
                </li>
              );
            })}
          </ul>
        </div>
      )}
    </div>
  </a>
</article>

<style>
  .fcase {
    position: relative;
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    border-radius: 6px;
    overflow: hidden;
    transition: border-color 140ms ease;
  }
  .fcase:hover { border-color: var(--accent); }
  .fcase__link {
    display: block;
    color: inherit;
    text-decoration: none;
    height: 100%;
    position: relative;
  }
  .fcase__stripe {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 4px;
    background: var(--accent);
    transition: width 140ms ease;
  }
  .fcase--noissues .fcase__stripe { background: var(--ok); }
  .fcase__link:hover .fcase__stripe { width: 6px; }
  .fcase__inner {
    padding: 1.1rem 1.2rem 1.1rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .fcase__head {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    gap: 0.9rem;
    align-items: flex-start;
  }
  .fcase__title { min-width: 0; }
  .fcase__name {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.05rem;
    margin: 0;
    color: var(--ink);
    line-height: 1.2;
    letter-spacing: -0.005em;
  }
  .fcase__cn {
    font-family: var(--font-cjk);
    font-weight: 500;
    color: var(--ink-soft);
    font-size: 0.82rem;
    margin: 0.18rem 0 0 0;
  }
  .fcase__count {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
    padding: 0.45rem 0.7rem;
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 4px;
    min-width: 4rem;
  }
  .fcase__count-num {
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--accent);
    line-height: 1;
  }
  .fcase--noissues .fcase__count-num { color: var(--ok); }
  .fcase__count-label {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    color: var(--ink-mute);
    letter-spacing: 0.04em;
  }
  :lang(zh) .fcase__count-label { font-family: var(--font-cjk); }
  .fcase__meta {
    font-size: 0.74rem;
    color: var(--ink-mute);
    margin: 0;
    line-height: 1.45;
    letter-spacing: 0.01em;
  }
  .fcase__pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .fcase__methods {
    border-top: 1px solid var(--rule);
    padding-top: 0.75rem;
    margin-top: 0.15rem;
  }
  .fcase__methods-h {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    color: var(--ink-mute);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 0.5rem 0;
    font-weight: 600;
  }
  :lang(zh) .fcase__methods-h { font-family: var(--font-cjk); letter-spacing: 0.1em; }
  .fcase__methods-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fcase__methods-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.25rem 0;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--ink-soft);
    border-bottom: 1px dotted var(--rule);
  }
  .fcase__methods-list li:last-child { border-bottom: 0; }
  :lang(zh) .fcase__methods-list li { font-family: var(--font-cjk); }
  .fcase__method-n { color: var(--accent); font-weight: 700; font-size: 0.9rem; }
</style>
