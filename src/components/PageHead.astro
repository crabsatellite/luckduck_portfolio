---
// Inner-page header: the night sky with the title, ending on a strip of
// moonlit ground that tiles across the full width.
import SiteHeader from "~/components/SiteHeader.astro";
import type { Lang } from "~/i18n/strings";

interface Props {
  lang: Lang;
  title: string;
  lead?: string;
}
const { lang, title, lead } = Astro.props;
---

<section class="ph sky">
  <SiteHeader lang={lang} />
  <div class="wrap ph__body">
    <slot name="before" />
    <h1 class="px px-48 shadow ph__title">{title}</h1>
    {lead && <p class="ph__lead">{lead}</p>}
    <slot />
  </div>
  <div class="ph__edge pixelated" aria-hidden="true"></div>
</section>

<style>
  .ph__body { padding-top: 40px; padding-bottom: 8px; }
  .ph__title { margin: 0; color: #fff; }
  .ph__lead { margin: 16px 0 0; max-width: 46em; font-size: 17px; color: var(--text-2); }
  /* edge.png: 192 x 64 source pixels, repeated at 2x */
  .ph__edge {
    height: 128px;
    margin-top: 8px;
    /* below the plant row the strip fades into the page, not the sky */
    background:
      var(--img-edge) 50% 0 / 384px 128px repeat-x,
      linear-gradient(to bottom, transparent 0 40px, var(--bg) 40px);
  }
  @media (max-width: 640px) {
    .ph__title { font-size: 36px; line-height: 48px; text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.55); }
    .ph__edge { height: 96px; }
  }
</style>
