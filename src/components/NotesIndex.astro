---
import { t, type Lang } from "~/i18n/strings";
import PageHead from "~/components/PageHead.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const cards = [
  ["notes.card1_h", "notes.card1_p"],
  ["notes.card2_h", "notes.card2_p"],
  ["notes.card3_h", "notes.card3_p"],
] as const;
const statusLabel = lang === "en" ? "planned" : "计划中";
const kicker = lang === "en" ? "notes · field log" : "notes · 现场笔记";
---

<article class="notes">
  <div class="container">
    <PageHead
      lang={lang}
      mark="04"
      kicker={kicker}
      title={t(lang, "notes.title")}
      sub={t(lang, "notes.subtitle")}
    />

    <div class="notes__grid">
      {cards.map(([h, p], i) => (
        <article class="notes__card">
          <span class="notes__idx mono tnum">№{String(i + 1).padStart(2, "0")}</span>
          <h2>{t(lang, h)}</h2>
          <p>{t(lang, p)}</p>
          <span class="notes__status mono">{statusLabel}</span>
        </article>
      ))}
    </div>
  </div>
</article>

<style>
  .notes { padding: 0 0 4rem 0; }
  .notes__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .notes__card {
    position: relative;
    min-height: 14rem;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--bg-soft);
    padding: 1.4rem 1.3rem 1.3rem 1.4rem;
  }
  .notes__idx {
    position: absolute;
    top: 0.6rem;
    right: 0.85rem;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ink-mute);
    font-size: 1.1rem;
    line-height: 1;
  }
  .notes__card h2 {
    margin: 0 0 0.6rem 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--fs-h3);
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  :lang(zh) .notes__card h2 { font-family: var(--font-cjk); letter-spacing: 0; }
  .notes__card p {
    margin: 0;
    flex: 1;
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    line-height: 1.68;
  }
  :lang(zh) .notes__card p { font-family: var(--font-cjk); line-height: 1.85; }
  .notes__status {
    align-self: flex-start;
    margin-top: 1.2rem;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius-pill);
    padding: 0.16rem 0.55rem;
    font-size: var(--fs-micro);
  }
  @media (max-width: 860px) {
    .notes__grid { grid-template-columns: 1fr; }
    .notes__card { min-height: 0; }
  }
</style>
