---
import { t, type Lang } from "~/i18n/strings";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const cards = [
  ["notes.card1_h", "notes.card1_p"],
  ["notes.card2_h", "notes.card2_p"],
  ["notes.card3_h", "notes.card3_p"],
] as const;
const statusLabel = lang === "en" ? "planned" : "计划中";
---

<article class="notes">
  <div class="container">
    <header class="notes__head">
      <p class="eyebrow"><strong>notes</strong></p>
      <h1 class="notes__title h-display">{t(lang, "notes.title")}</h1>
      <p class="notes__sub">{t(lang, "notes.subtitle")}</p>
    </header>

    <div class="notes__grid">
      {cards.map(([h, p]) => (
        <article class="notes__card">
          <h2>{t(lang, h)}</h2>
          <p>{t(lang, p)}</p>
          <span class="notes__status mono">{statusLabel}</span>
        </article>
      ))}
    </div>
  </div>
</article>

<style>
  .notes {
    padding: 2.4rem 0 4rem 0;
  }
  .notes__head {
    max-width: 72ch;
    margin-bottom: 1.6rem;
  }
  .notes__title {
    font-size: clamp(1.9rem, 4vw, 3rem);
    margin: 0.4rem 0 0.65rem 0;
  }
  .notes__sub {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.7;
  }
  :lang(zh) .notes__sub { font-family: var(--font-cjk); line-height: 1.85; }
  .notes__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .notes__card {
    min-height: 14rem;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    background: var(--bg-soft);
    border-radius: var(--radius);
    padding: 1.2rem 1.3rem;
  }
  .notes__card h2 {
    margin: 0 0 0.6rem 0;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 1.08rem;
    line-height: 1.3;
  }
  :lang(zh) .notes__card h2 { font-family: var(--font-cjk); }
  .notes__card p {
    margin: 0;
    flex: 1;
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: 0.94rem;
    line-height: 1.68;
  }
  :lang(zh) .notes__card p { font-family: var(--font-cjk); line-height: 1.85; }
  .notes__status {
    align-self: flex-start;
    margin-top: 1.2rem;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius-pill);
    padding: 0.16rem 0.55rem;
    font-size: 0.72rem;
  }
  @media (max-width: 860px) {
    .notes__grid { grid-template-columns: 1fr; }
    .notes__card { min-height: 0; }
  }
</style>
