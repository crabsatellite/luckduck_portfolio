---
interface Props {
  size?: number;
  alt?: string;
  blink?: boolean;
}
const { size = 96, alt = "LUCK666DUCK mascot", blink = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const src = `${base}/mascot.png`;
---

<span
  class:list={["mascot", { "mascot--blink": blink }]}
  style={`--mascot-size:${size}px`}
  aria-hidden={alt === "" ? "true" : undefined}
>
  <img
    src={src}
    width={size}
    height={size}
    alt={alt}
    loading="eager"
    decoding="async"
  />
  {blink && (
    <span class="mascot__blink-overlay" aria-hidden="true">
      <img
        src={`${base}/mascot-blink.png`}
        width={size}
        height={size}
        alt=""
        loading="eager"
        decoding="async"
      />
    </span>
  )}
</span>

<style>
  .mascot {
    position: relative;
    display: inline-block;
    width: var(--mascot-size);
    height: var(--mascot-size);
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;
    line-height: 0;
  }
  .mascot img {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }
  .mascot__blink-overlay {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: mascot-blink 4s steps(1, end) infinite;
  }
  @keyframes mascot-blink {
    0%, 92% { opacity: 0; }
    94% { opacity: 1; }
    96% { opacity: 0; }
    98% { opacity: 1; }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mascot__blink-overlay { animation: none; opacity: 0; }
  }
</style>
