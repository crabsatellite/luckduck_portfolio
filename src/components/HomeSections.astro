---
import { t, type Lang } from "~/i18n/strings";
import ModCard from "~/components/ModCard.astro";
import RetroBadgeStrip from "~/components/RetroBadgeStrip.astro";
import { featuredMods, profile } from "~/lib/data";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const langPrefix = lang === "en" ? `${base}/en` : base;
const featured = featuredMods();

const services = [
  ["home.services_regression_h", "home.services_regression_p"],
  ["home.services_compat_h", "home.services_compat_p"],
  ["home.services_i18n_h", "home.services_i18n_p"],
  ["home.services_report_h", "home.services_report_p"],
] as const;

const noteCards = [
  ["notes.card1_h", "notes.card1_p"],
  ["notes.card2_h", "notes.card2_p"],
  ["notes.card3_h", "notes.card3_p"],
] as const;
---

<section class="home-block" aria-labelledby="authors-h">
  <div class="container">
    <header class="home-head">
      <h2 id="authors-h" class="home-head__title h-section">{t(lang, "home.for_authors_h")}</h2>
      <p class="home-head__sub">{t(lang, "home.for_authors_sub")}</p>
    </header>
    <div class="service-grid">
      {services.map(([h, p]) => (
        <article class="service-card">
          <h3>{t(lang, h)}</h3>
          <p>{t(lang, p)}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="home-block home-block--split" aria-labelledby="proof-h">
  <div class="container proof-grid">
    <div>
      <header class="home-head">
        <h2 id="proof-h" class="home-head__title h-section">{t(lang, "home.proof_h")}</h2>
        <p class="home-head__sub">{t(lang, "home.proof_sub")}</p>
      </header>
      <RetroBadgeStrip />
    </div>
    <aside class="credit-panel">
      <h3>{lang === "en" ? "Public tester credits" : "公开 Tester 署名"}</h3>
      <ul>
        {profile.curseforge.tester_credits.map((credit) => (
          <li>
            <a href={credit.mod_url} rel="noopener" target="_blank">{credit.mod}</a>
            <span class="mono tnum">{credit.downloads_at_snapshot.toLocaleString("en-US")} DL</span>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</section>

<section class="home-block" aria-labelledby="featured-h">
  <div class="container">
    <header class="home-head home-head--row">
      <div>
        <h2 id="featured-h" class="home-head__title h-section">{t(lang, "home.featured_h")}</h2>
        <p class="home-head__sub">{t(lang, "home.featured_sub")}</p>
      </div>
      <a class="text-link" href={`${langPrefix}/cases`}>{t(lang, "home.all_cases_link")} →</a>
    </header>
    <div class="cases-grid cases-grid--featured">
      {featured.map((m) => <ModCard mod={m} lang={lang} />)}
    </div>
  </div>
</section>

<section class="home-block home-block--notes" aria-labelledby="notes-h">
  <div class="container notes-layout">
    <header class="home-head">
      <h2 id="notes-h" class="home-head__title h-section">{t(lang, "home.notes_h")}</h2>
      <p class="home-head__sub">{t(lang, "home.notes_sub")}</p>
      <div class="note-actions">
        <a class="btn btn--accent" href={`${langPrefix}/notes`}>{t(lang, "home.notes_link")}</a>
        <a class="btn" href={`${langPrefix}/methodology`}>{t(lang, "home.methods_link")}</a>
      </div>
    </header>
    <div class="note-cards">
      {noteCards.map(([h, p]) => (
        <article class="note-card">
          <h3>{t(lang, h)}</h3>
          <p>{t(lang, p)}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .home-block {
    padding: clamp(2.2rem, 5vw, 3.5rem) 0;
    border-top: 1px solid var(--rule);
  }
  .home-block--split {
    background: color-mix(in oklch, var(--bg-soft) 45%, transparent);
  }
  .home-block--notes {
    padding-bottom: 4rem;
  }
  .home-head {
    max-width: 70ch;
    margin-bottom: 1.3rem;
  }
  .home-head--row {
    max-width: none;
    display: flex;
    justify-content: space-between;
    gap: 1.4rem;
    align-items: end;
  }
  .home-head__title {
    color: var(--ink);
    margin: 0;
  }
  .home-head__sub {
    margin: 0.55rem 0 0 0;
    font-family: var(--font-sans);
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.7;
  }
  :lang(zh) .home-head__sub { font-family: var(--font-cjk); line-height: 1.85; }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .service-card,
  .note-card,
  .credit-panel {
    border: 1px solid var(--rule);
    background: var(--bg-soft);
    border-radius: var(--radius);
    padding: 1.1rem 1.2rem;
  }
  .service-card {
    border-top: 4px solid var(--accent);
  }
  .service-card h3,
  .note-card h3,
  .credit-panel h3 {
    margin: 0 0 0.55rem 0;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--ink);
  }
  :lang(zh) .service-card h3,
  :lang(zh) .note-card h3,
  :lang(zh) .credit-panel h3 { font-family: var(--font-cjk); }
  .service-card p,
  .note-card p {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.65;
  }
  :lang(zh) .service-card p,
  :lang(zh) .note-card p { font-family: var(--font-cjk); line-height: 1.8; }
  .proof-grid,
  .notes-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.85fr);
    gap: 2rem;
    align-items: start;
  }
  .credit-panel ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .credit-panel li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px dotted var(--rule);
    font-family: var(--font-sans);
    font-size: 0.92rem;
  }
  .credit-panel li:last-child { border-bottom: 0; }
  .credit-panel a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .credit-panel a:hover,
  .credit-panel a:focus-visible {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .credit-panel .mono {
    color: var(--ink-mute);
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .cases-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .text-link {
    font-family: var(--font-sans);
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    white-space: nowrap;
    margin-bottom: 0.2rem;
  }
  :lang(zh) .text-link { font-family: var(--font-cjk); }
  .text-link:hover { color: var(--accent-deep); }
  .note-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.2rem;
  }
  .note-cards {
    display: grid;
    gap: 0.85rem;
  }
  @media (max-width: 980px) {
    .service-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cases-grid { grid-template-columns: 1fr; }
    .proof-grid,
    .notes-layout { grid-template-columns: 1fr; }
  }
  @media (max-width: 680px) {
    .home-head--row { display: block; }
    .text-link { display: inline-block; margin-top: 1rem; }
    .service-grid { grid-template-columns: 1fr; }
  }
</style>
