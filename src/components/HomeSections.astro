---
import { t, type Lang } from "~/i18n/strings";
import ModCard from "~/components/ModCard.astro";
import RetroBadgeStrip from "~/components/RetroBadgeStrip.astro";
import MascotDuck from "~/components/MascotDuck.astro";
import { creditDownloadsLabel, featuredMods, prCredits, profile, remoteMetrics } from "~/lib/data";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const langPrefix = lang === "en" ? `${base}/en` : base;
const featured = featuredMods();
const metricsDate = remoteMetrics.fetched_at
  ? new Date(remoteMetrics.fetched_at).toISOString().slice(0, 10)
  : null;
const prCreditList = prCredits();

const services = [
  {
    h: t(lang, "home.services_regression_h"),
    p: t(lang, "home.services_regression_p"),
    tag: lang === "en" ? "by version · by round" : "按版本 · 按轮次",
    glyph: "▤",
  },
  {
    h: t(lang, "home.services_compat_h"),
    p: t(lang, "home.services_compat_p"),
    tag: lang === "en" ? "mods · shaders · MP" : "MOD · shader · 多人",
    glyph: "◆",
  },
  {
    h: t(lang, "home.services_i18n_h"),
    p: t(lang, "home.services_i18n_p"),
    tag: lang === "en" ? "zh-CN · zh-HK · ja · en" : "简 · 繁 · 日 · 英",
    glyph: "字",
  },
  {
    h: t(lang, "home.services_report_h"),
    p: t(lang, "home.services_report_p"),
    tag: lang === "en" ? "ready for triage" : "作者可直接处理",
    glyph: "✎",
  },
];

const noteCards = [
  ["notes.card1_h", "notes.card1_p"],
  ["notes.card2_h", "notes.card2_p"],
  ["notes.card3_h", "notes.card3_p"],
] as const;
---

<!-- ================== SECTION 02 · FIELD MANUAL (cream paper) ================== -->
<section
  class="home-block panel panel--cream"
  aria-labelledby="authors-h"
  data-reveal
>
  <div class="container home-block__inner">
    <header class="page-head">
      <div class="page-head__rail">
        <p class="section-marker__kicker">{t(lang, "home.section_field_manual")}</p>
        <span class="page-head__num fancy-num fancy-num--accent">02</span>
      </div>
      <div class="page-head__body">
        <h2 id="authors-h" class="page-head__title">{t(lang, "home.for_authors_h")}</h2>
        <p class="page-head__sub">{t(lang, "home.for_authors_sub")}</p>
      </div>
    </header>

    <div class="manual-list">
      {services.map((s, i) => (
        <article class="manual-row">
          <div class="manual-row__rail" aria-hidden="true">
            <span class="manual-row__num fancy-num fancy-num--accent">{String(i + 1).padStart(2, "0")}</span>
            <span class="manual-row__glyph">{s.glyph}</span>
          </div>
          <div class="manual-row__body">
            <h3 class="manual-row__h">{s.h}</h3>
            <p class="manual-row__p">{s.p}</p>
          </div>
          <div class="manual-row__tag dateline">{s.tag}</div>
        </article>
      ))}
    </div>

    <figure class="pull-quote-wrap" aria-label="house rule">
      <blockquote class="pull-quote">
        <span class="pull-quote__mark" aria-hidden="true">“</span>
        {t(lang, "quote.regression")}
        <span class="pull-quote__attr">{t(lang, "quote.regression_attr")}</span>
      </blockquote>
    </figure>
  </div>
</section>

<!-- ================== SECTION 03 · EVIDENCE (deep warm panel) ================== -->
<section
  class="home-block panel panel--coffee"
  aria-labelledby="proof-h"
  data-reveal
>
  <div class="container home-block__inner">
    <header class="page-head">
      <div class="page-head__rail">
        <p class="section-marker__kicker">{t(lang, "home.section_evidence")}</p>
        <span class="page-head__num fancy-num fancy-num--accent">03</span>
      </div>
      <div class="page-head__body">
        <h2 id="proof-h" class="page-head__title">{t(lang, "home.proof_h")}</h2>
        <p class="page-head__sub">{t(lang, "home.proof_sub")}</p>
      </div>
    </header>

    <div class="proof-grid">
      <div class="proof-main">
        <div class="proof-badges">
          <RetroBadgeStrip />
        </div>

        <figure class="pull-quote-wrap proof-quote" aria-label="house rule">
          <blockquote class="pull-quote">
            <span class="pull-quote__mark" aria-hidden="true">“</span>
            {t(lang, "quote.evidence")}
            <span class="pull-quote__attr">{t(lang, "quote.evidence_attr")}</span>
          </blockquote>
        </figure>
      </div>

      <aside class="credit-panel ledger-card cornered">
        <div class="credit-panel__head">
          <h3 class="credit-panel__h">{lang === "en" ? "Public credits" : "公开署名"}</h3>
          <span class="stamp stamp--ok">{lang === "en" ? "verified" : "已核实"}</span>
        </div>

        <p class="credit-panel__subh caption">
          {lang === "en" ? "CurseForge member panel" : "CurseForge 成员栏"}
        </p>
        <ul class="credit-panel__list">
          {profile.curseforge.tester_credits.map((credit) => (
            <li class="credit-panel__row">
              <span class="credit-panel__row-bullet" aria-hidden="true">◦</span>
              <a href={credit.mod_url} rel="noopener" target="_blank" class="credit-panel__link">
                <span class="credit-panel__mod">{credit.mod}</span>
                <span class="credit-panel__role caption">tester · CrabMods</span>
              </a>
              <span class="credit-panel__dl mono tnum">{creditDownloadsLabel(credit)}</span>
            </li>
          ))}
        </ul>

        {prCreditList.length > 0 && (
          <>
            <p class="credit-panel__subh caption credit-panel__subh--pr">
              {lang === "en" ? "Merged PR body" : "已合并 PR 描述"}
            </p>
            <ul class="credit-panel__list credit-panel__list--pr">
              {prCreditList.map((credit) => {
                const merged = credit.prs.filter((p) => p.merged);
                const total = credit.prs.length;
                const meta = lang === "en"
                  ? `tester · ${merged.length}/${total} merged`
                  : `测试 · ${merged.length}/${total} 已合并`;
                return (
                  <li class="credit-panel__row">
                    <span class="credit-panel__row-bullet" aria-hidden="true">◦</span>
                    <div class="credit-panel__link credit-panel__link--prs">
                      <span class="credit-panel__mod">{credit.mod}</span>
                      <span class="credit-panel__role caption">{meta}</span>
                      <span class="credit-panel__prs">
                        {credit.prs.map((pr, i) => (
                          <>
                            {i > 0 && <span class="credit-panel__prs-sep" aria-hidden="true">·</span>}
                            <a
                              href={pr.url}
                              rel="noopener"
                              target="_blank"
                              class={`credit-panel__pr mono tnum${pr.merged ? "" : " credit-panel__pr--unmerged"}`}
                              title={`${pr.author}/${credit.repo}#${pr.number} · ${pr.title}`}
                            >
                              #{pr.number}
                            </a>
                          </>
                        ))}
                      </span>
                    </div>
                  </li>
                );
              })}
            </ul>
          </>
        )}

        {metricsDate && (
          <p class="credit-panel__meta">
            <span class="caption">{lang === "en" ? "Remote snapshot" : "远程快照"}</span>
            <span class="mono">{metricsDate}</span>
          </p>
        )}
      </aside>
    </div>
  </div>
</section>

<!-- ================== SECTION 04 · CASE STUDIES (warm-dark) ==================== -->
<section
  class="home-block home-block--featured"
  aria-labelledby="featured-h"
  data-reveal
>
  <div class="container home-block__inner">
    <header class="page-head page-head--row">
      <div class="page-head__main">
        <div class="page-head__rail">
          <p class="section-marker__kicker">{t(lang, "home.section_cases")}</p>
          <span class="page-head__num fancy-num fancy-num--accent">04</span>
        </div>
        <div class="page-head__body">
          <h2 id="featured-h" class="page-head__title">{t(lang, "home.featured_h")}</h2>
          <p class="page-head__sub">{t(lang, "home.featured_sub")}</p>
        </div>
      </div>
      <a class="text-link" href={`${langPrefix}/cases`}>
        <span>{t(lang, "home.all_cases_link")}</span>
        <span class="text-link__arrow" aria-hidden="true">→</span>
      </a>
    </header>
    <div class="cases-grid cases-grid--featured">
      {featured.map((m, i) => <ModCard mod={m} lang={lang} index={i + 1} />)}
    </div>
  </div>
</section>

<!-- ================== SECTION 05 · FIELD NOTES (cream paper) ==================== -->
<section
  class="home-block panel panel--cream home-block--notes"
  aria-labelledby="notes-h"
  data-reveal
>
  <div class="container home-block__inner">
    <header class="page-head">
      <div class="page-head__rail">
        <p class="section-marker__kicker">{t(lang, "home.section_notes")}</p>
        <span class="page-head__num fancy-num fancy-num--accent">05</span>
      </div>
      <div class="page-head__body">
        <h2 id="notes-h" class="page-head__title">{t(lang, "home.notes_h")}</h2>
        <p class="page-head__sub">{t(lang, "home.notes_sub")}</p>
        <div class="note-actions">
          <a class="btn btn--accent" href={`${langPrefix}/notes`}>{t(lang, "home.notes_link")}</a>
          <a class="btn" href={`${langPrefix}/methodology`}>{t(lang, "home.methods_link")}</a>
        </div>
      </div>
    </header>
    <div class="notes-grid">
      <aside class="notes-mascot" aria-hidden="true">
        <MascotDuck size={120} alt="" />
        <p class="caption notes-mascot__caption">
          {lang === "en" ? "Writing them up between rounds." : "两轮之间随手记下。"}
        </p>
      </aside>
      <div class="note-cards">
        {noteCards.map(([h, p], i) => (
          <article class="note-card ledger-card">
            <div class="note-card__head">
              <span class="note-card__idx mono tnum">№{String(i + 1).padStart(2, "0")}</span>
              <span class="note-card__pill pill">{lang === "en" ? "draft · planned" : "计划中 · draft"}</span>
            </div>
            <h3 class="note-card__h">{t(lang, h)}</h3>
            <p class="note-card__p">{t(lang, p)}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- additive scroll-reveal: applies a one-off entry animation when
     an element first scrolls into view. Content is fully visible
     by default — this script only adds the animation flag. -->
<script is:inline>
  (function () {
    if (typeof window === "undefined") return;
    if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (!("IntersectionObserver" in window)) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.setAttribute("data-revealed", "1");
          io.unobserve(entry.target);
        }
      });
    }, { rootMargin: "0px 0px -6% 0px", threshold: 0.05 });
    document.querySelectorAll("[data-reveal]").forEach(function (el) {
      io.observe(el);
    });
  })();
</script>

<style>
  .home-block {
    padding: clamp(3rem, 6vw, 5rem) 0;
    position: relative;
  }
  .home-block__inner { position: relative; z-index: 1; }
  .home-block--featured {
    background:
      radial-gradient(70% 60% at 90% 10%, color-mix(in oklch, var(--accent) 14%, transparent) 0%, transparent 70%),
      var(--bg);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .home-block--notes {
    padding-bottom: clamp(3.5rem, 7vw, 5.5rem);
  }

  /* full-bleed colored panels read across the page; container
     keeps reading content gutter consistent inside */
  .panel.home-block {
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding-left: 0;
    padding-right: 0;
  }

  /* ---- shared page-head pattern with big italic numeral ------ */
  .page-head {
    display: grid;
    grid-template-columns: minmax(0, 0.34fr) minmax(0, 1fr);
    gap: clamp(1.4rem, 3.4vw, 2.6rem);
    align-items: start;
    padding-bottom: clamp(1.6rem, 4vw, 2.4rem);
    margin-bottom: clamp(1.6rem, 4vw, 2.4rem);
    border-bottom: 1px solid var(--rule);
    position: relative;
  }
  .page-head::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
    background: var(--ink);
  }
  .page-head--row {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
  }
  .page-head--row .page-head__main {
    display: grid;
    grid-template-columns: minmax(0, 0.34fr) minmax(0, 1fr);
    gap: clamp(1.4rem, 3.4vw, 2.6rem);
    align-items: start;
  }
  .page-head__rail {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-right: clamp(0.6rem, 2vw, 1.2rem);
    border-right: 1px dotted var(--rule);
  }
  .page-head__num {
    font-size: clamp(3.2rem, 6vw, 4.6rem);
    line-height: 0.85;
  }
  .page-head__body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-width: 0;
  }
  .page-head__title {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.65rem, 3.4vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--ink);
    max-width: 22ch;
  }
  :lang(zh) .page-head__title {
    font-family: var(--font-cjk);
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.32;
  }
  .page-head__sub {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--ink-soft);
    font-size: 1.02rem;
    line-height: 1.7;
    max-width: 60ch;
  }
  :lang(zh) .page-head__sub {
    font-family: var(--font-cjk);
    line-height: 1.85;
  }
  @media (max-width: 720px) {
    .page-head,
    .page-head--row .page-head__main {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
    .page-head__rail {
      flex-direction: row;
      align-items: baseline;
      gap: 0.9rem;
      border-right: none;
      border-bottom: 1px dotted var(--rule);
      padding-right: 0;
      padding-bottom: 0.6rem;
    }
    .page-head__num { font-size: 2.6rem; }
    .page-head--row {
      grid-template-columns: 1fr;
    }
  }

  /* ---- field manual list ----------------------------------- */
  .manual-list {
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    margin-bottom: 2.2rem;
  }
  .manual-row {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr) auto;
    gap: clamp(1.2rem, 2.5vw, 2.2rem);
    align-items: start;
    padding: 1.5rem 0.4rem;
    border-bottom: 1px dashed var(--rule);
    position: relative;
    transition: background 200ms ease;
  }
  .manual-row:last-child { border-bottom: 0; }
  .manual-row::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: transparent;
    transition: background 200ms ease;
  }
  .manual-row:hover {
    background: color-mix(in oklch, var(--accent) 6%, transparent);
  }
  .manual-row:hover::before {
    background: var(--accent);
  }
  .manual-row__rail {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    padding-left: 0.6rem;
  }
  .manual-row__num {
    font-size: clamp(2.4rem, 4.4vw, 3.1rem);
    line-height: 0.82;
  }
  .manual-row__glyph {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ink-mute);
    font-size: 1.4rem;
    line-height: 1;
  }
  :lang(zh) .manual-row__glyph {
    font-family: var(--font-cjk);
    font-style: normal;
  }
  .manual-row__body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .manual-row__h {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
    font-size: 1.32rem;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  :lang(zh) .manual-row__h {
    font-family: var(--font-cjk);
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0;
  }
  .manual-row__p {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--ink-soft);
    font-size: 0.96rem;
    line-height: 1.65;
    max-width: 56ch;
  }
  :lang(zh) .manual-row__p {
    font-family: var(--font-cjk);
    line-height: 1.85;
  }
  .manual-row__tag {
    color: var(--ink-mute);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    white-space: nowrap;
    text-align: right;
    align-self: center;
  }
  :lang(zh) .manual-row__tag { letter-spacing: 0.04em; }

  /* ---- pull quote wrapper ---------------------------------- */
  .pull-quote-wrap {
    margin: 0;
    padding: clamp(1.4rem, 3vw, 2.2rem) 0 0.4rem 0;
    border-top: 1px solid var(--rule);
  }
  .proof-quote {
    margin-top: 2rem;
    padding-top: 1.8rem;
    border-top: 1px solid color-mix(in oklch, var(--steam) 30%, transparent);
  }

  /* ---- proof grid ------------------------------------------ */
  .proof-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(300px, 0.85fr);
    gap: 2.4rem;
    align-items: start;
  }
  .proof-main { min-width: 0; }
  .proof-badges {
    margin-top: 0.4rem;
  }
  .proof-badges :global(.badge-strip) {
    background: color-mix(in oklch, var(--accent) 8%, transparent);
    border-color: color-mix(in oklch, var(--accent) 24%, transparent);
  }

  .credit-panel {
    padding: 1.4rem 1.5rem 1.6rem 1.5rem;
    position: relative;
    /* slightly lighter warm-coffee so the panel reads as raised on
       top of the section background — same family, warmer tint. */
    background:
      linear-gradient(180deg, #221912 0%, #1a130d 100%);
    border-color: color-mix(in oklch, var(--accent) 22%, #3a2c1e);
    color: #f3ecd6;
    --ink: #f3ecd6;
    --ink-soft: #d8cdb5;
    --ink-mute: #a59880;
    --rule: color-mix(in oklch, var(--accent) 16%, #3a2c1e);
  }
  .credit-panel .stamp--ok {
    color: var(--ok);
    border-color: var(--ok);
    background: color-mix(in oklch, var(--ok) 16%, transparent);
  }
  .credit-panel__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }
  .credit-panel__h {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
    font-size: 1.08rem;
    color: var(--ink);
    letter-spacing: -0.005em;
  }
  :lang(zh) .credit-panel__h { font-family: var(--font-cjk); font-style: normal; font-weight: 400; letter-spacing: 0; }
  .credit-panel__list { list-style: none; padding: 0; margin: 0; }
  .credit-panel__row {
    display: grid;
    grid-template-columns: 0.8rem 1fr auto;
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.65rem 0;
    border-bottom: 1px dotted var(--rule);
  }
  .credit-panel__row:last-child { border-bottom: 0; }
  .credit-panel__row-bullet {
    color: var(--accent);
    font-family: var(--font-mono);
    line-height: 1;
  }
  .credit-panel__link {
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
    border-bottom: 1px solid transparent;
    width: fit-content;
  }
  .credit-panel__link:hover,
  .credit-panel__link:focus-visible {
    color: var(--accent);
  }
  .credit-panel__mod {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.96rem;
  }
  .credit-panel__role { color: var(--ink-mute); }
  .credit-panel__dl {
    color: var(--accent);
    font-size: 0.85rem;
    white-space: nowrap;
    font-weight: 600;
  }
  .credit-panel__subh {
    color: var(--ink-mute);
    margin: 0 0 0.4rem 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
  }
  .credit-panel__subh--pr {
    margin-top: 1.05rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--rule);
  }
  .credit-panel__list--pr .credit-panel__row {
    grid-template-columns: 0.8rem 1fr;
    align-items: start;
  }
  .credit-panel__link--prs {
    cursor: default;
  }
  .credit-panel__prs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0 0.45rem;
    margin-top: 0.2rem;
    font-size: 0.82rem;
  }
  .credit-panel__pr {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklch, var(--accent) 45%, transparent);
    padding-bottom: 1px;
    transition: color 120ms ease, border-color 120ms ease;
  }
  .credit-panel__pr:hover,
  .credit-panel__pr:focus-visible {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
  .credit-panel__pr--unmerged {
    color: var(--ink-mute);
    border-bottom-color: var(--ink-faint);
    font-style: italic;
  }
  .credit-panel__prs-sep {
    color: var(--ink-faint);
    user-select: none;
  }
  .credit-panel__meta {
    margin: 0.95rem 0 0 0;
    display: flex;
