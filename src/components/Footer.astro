---
import { t, type Lang } from "~/i18n/strings";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<footer class="footer">
  <div class="footer__inner container">
    <hr class="hairline" />
    <div class="footer__cols">
      <div class="footer__col">
        <p class="footer__handle">CASE-FILE / {t(lang, "footer.handle")}</p>
        <p class="footer__cn" aria-hidden="true">{t(lang, "footer.cn_name")}</p>
        <p class="footer__active">{t(lang, "footer.active")}</p>
      </div>
      <div class="footer__col">
        <ul class="footer__links">
          <li>
            <a href="https://github.com/LUCK666DUCK" rel="noopener" target="_blank">
              github.com/LUCK666DUCK <span aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a href="https://www.curseforge.com/members/luck666duck" rel="noopener" target="_blank">
              curseforge / luck666duck <span aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>
      <div class="footer__col footer__col--meta">
        <p class="footer__copy">{t(lang, "footer.copy")}</p>
        <p class="footer__version mono">v0.1.0</p>
      </div>
    </div>
    <hr class="hairline" />
  </div>
</footer>

<style>
  .footer { margin-top: 6rem; }
  .footer__inner { padding-top: 2rem; padding-bottom: 2rem; }
  .footer__cols {
    display: grid;
    grid-template-columns: 1fr 1fr 1.5fr;
    gap: 2rem;
    padding: 1.6rem 0;
  }
  @media (max-width: 760px) {
    .footer__cols { grid-template-columns: 1fr; gap: 1.2rem; }
  }
  .footer__col p { margin: 0 0 0.4rem 0; }
  .footer__handle {
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.12em;
    font-size: 0.85rem;
  }
  .footer__cn {
    font-family: var(--font-cjk);
    color: var(--ink-mute);
    font-size: 0.85rem;
    letter-spacing: 0.18em;
  }
  .footer__active {
    font-family: var(--font-mono);
    color: var(--ink-mute);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
  }
  .footer__links { list-style: none; padding: 0; margin: 0; }
  .footer__links li { margin-bottom: 0.4rem; }
  .footer__links a {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.02em;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
  }
  .footer__links a:hover, .footer__links a:focus-visible {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .footer__copy {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--ink-mute);
    line-height: 1.6;
    max-width: 60ch;
  }
  :lang(zh) .footer__copy { font-family: var(--font-cjk); line-height: 1.85; }
  .footer__version {
    color: var(--ink-faint);
    font-size: 0.78rem;
    margin-top: 0.6rem;
    letter-spacing: 0.06em;
  }
</style>
