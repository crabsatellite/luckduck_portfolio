---
import { t, tf, type Lang } from "~/i18n/strings";
import { asset, href } from "~/lib/paths";
import { metricsDay, profile } from "~/lib/data";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const day = metricsDay() ?? "—";
---

<footer class="foot">
  <div class="wrap foot__grid">
    <div class="foot__id">
      <img class="pixelated" src={asset("art/duck-large.png")} width="48" height="44" alt="" />
      <div>
        <p class="ui foot__name">LUCK666DUCK</p>
        <p class="foot__line">{t(lang, "footer.line")}</p>
      </div>
    </div>
    <nav class="foot__links" aria-label="Footer">
      <a href={href(lang, "/cases")}>{t(lang, "nav.cases")}</a>
      <a href={href(lang, "/methodology")}>{t(lang, "nav.methods")}</a>
      <a href={href(lang, "/about")}>{t(lang, "nav.about")}</a>
      <a href={profile.curseforge.profile_url} rel="noopener">CurseForge ↗</a>
      <a href={profile.github.url} rel="noopener">GitHub ↗</a>
    </nav>
    <div class="foot__notes">
      <p>{tf(lang, "footer.data", { day })}</p>
      <p>{t(lang, "footer.art")}</p>
      <p>
        <a href={asset("fonts/OFL.txt")}>{t(lang, "footer.font")}</a>
        <span aria-hidden="true"> · </span>
        <a href="https://github.com/crabsatellite/luckduck_portfolio" rel="noopener">{t(lang, "footer.source")}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: 120px;
    padding: 40px 0 48px;
    background: #08090c;
    box-shadow: inset 0 var(--u) 0 #1b1e25;
    font-size: 14px;
    color: var(--text-3);
  }
  .foot__grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px 48px;
    align-items: start;
  }
  .foot__id { display: flex; gap: 16px; align-items: center; }
  .foot__id img { display: block; }
  .foot__name { margin: 0; color: var(--text); }
  .foot__line { margin: 0; }
  .foot__links { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: flex-end; padding-top: 10px; }
  .foot__links a { color: var(--text-2); text-decoration: none; }
  .foot__links a:hover { color: var(--gold); }
  .foot__notes { grid-column: 1 / -1; display: grid; gap: 2px; padding-top: 20px; box-shadow: inset 0 var(--u) 0 #15181e; }
  .foot__notes p { margin: 0; }
  .foot__notes a { color: var(--text-2); }
  @media (max-width: 720px) {
    .foot__grid { grid-template-columns: 1fr; }
    .foot__links { justify-content: flex-start; padding-top: 0; }
  }
</style>
