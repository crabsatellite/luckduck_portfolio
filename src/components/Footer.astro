---
import { t, type Lang } from "~/i18n/strings";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<footer class="footer">
  <div class="container">
    <div class="footer__cols">
      <div class="footer__col">
        <p class="footer__handle">{t(lang, "footer.handle")} · {t(lang, "footer.cn_name")}</p>
        <p class="footer__tag">{t(lang, "footer.tagline")}</p>
        <p class="footer__active mono tnum">{t(lang, "footer.active")}</p>
      </div>
      <div class="footer__col">
        <ul class="footer__links">
          <li>
            <a href="https://github.com/LUCK666DUCK" rel="noopener" target="_blank">
              github / LUCK666DUCK <span aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a href="https://www.curseforge.com/members/luck666duck" rel="noopener" target="_blank">
              curseforge / luck666duck <span aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <hr class="footer__rule" />
    <div class="footer__meta">
      <p class="footer__copy">{t(lang, "footer.copy")}</p>
      <p class="footer__version mono">
        {t(lang, "footer.archived")}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 5rem;
    padding-top: 2.4rem;
    padding-bottom: 1.6rem;
    border-top: 1px solid var(--rule);
  }
  .footer__cols {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
    padding: 0 0 1.6rem 0;
    align-items: start;
  }
  @media (max-width: 720px) {
    .footer__cols { grid-template-columns: 1fr; gap: 1.2rem; }
  }
  .footer__col p { margin: 0 0 0.4rem 0; }
  .footer__handle {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1rem;
    color: var(--ink);
    letter-spacing: 0.02em;
  }
  :lang(zh) .footer__handle { font-family: var(--font-cjk); }
  .footer__tag {
    font-family: var(--font-sans);
    color: var(--ink-mute);
    font-size: 0.85rem;
  }
  :lang(zh) .footer__tag { font-family: var(--font-cjk); }
  .footer__active {
    font-size: 0.78rem;
    color: var(--ink-mute);
    letter-spacing: 0.04em;
  }
  .footer__links { list-style: none; padding: 0; margin: 0; }
  .footer__links li { margin-bottom: 0.5rem; }
  .footer__links a {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
  }
  .footer__links a:hover, .footer__links a:focus-visible {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .footer__rule {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 0;
  }
  .footer__meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    align-items: baseline;
    padding-top: 1rem;
  }
  .footer__copy {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--ink-mute);
    line-height: 1.55;
    max-width: 60ch;
    margin: 0;
  }
  :lang(zh) .footer__copy { font-family: var(--font-cjk); line-height: 1.75; }
  .footer__version {
    font-size: 0.78rem;
    color: var(--ink-mute);
    letter-spacing: 0.04em;
    margin: 0;
  }
  .footer__version a { color: var(--accent); text-decoration: none; }
  .footer__version a:hover { text-decoration: underline; }
  .footer__sep { margin: 0 0.4rem; opacity: 0.4; }
</style>
