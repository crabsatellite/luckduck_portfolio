---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import ActivityFeed from "~/components/ActivityFeed.astro";
import Deliverables from "~/components/Deliverables.astro";
import { t } from "~/i18n/strings";

const lang = "en" as const;
---

<BaseLayout title="LUCK666DUCK" lang={lang}>
  <Hero lang={lang} />

  <section class="block" aria-labelledby="activity-h">
    <div class="container">
      <h2 id="activity-h" class="block__h">{t(lang, "home.activity_h")}</h2>
      <ActivityFeed lang={lang} />
    </div>
  </section>

  <section class="block" aria-labelledby="deliv-h">
    <div class="container">
      <h2 id="deliv-h" class="block__h">{t(lang, "home.deliverables_h")}</h2>
      <Deliverables lang={lang} />
    </div>
  </section>
</BaseLayout>

<style>
  .block { padding: 2.4rem 0; }
  .block + .block { border-top: 1px solid var(--rule); }
  .block__h {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.78rem;
    color: var(--ink-mute);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.2rem 0;
  }
</style>
