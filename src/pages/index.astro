---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import FeaturedCaseCard from "~/components/FeaturedCaseCard.astro";
import SeverityLegend from "~/components/SeverityLegend.astro";
import { featuredMods, methods, categoryCounts } from "~/lib/data";
import { t } from "~/i18n/strings";

const lang = "zh" as const;
const featured = featuredMods();
const counts = categoryCounts();
const topMethods = [...methods]
  .sort((a, b) => (counts[b.category_id] || 0) - (counts[a.category_id] || 0))
  .slice(0, 6);

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const langPrefix = base;
---

<BaseLayout title="LUCK666DUCK" lang={lang}>
  <Hero lang={lang} />

  <section class="block" id="methods" aria-labelledby="methods-h">
    <div class="container">
      <header class="block__head">
        <p class="block__eyebrow">01 / methodology</p>
        <h2 id="methods-h" class="block__h h-section">{t(lang, "home.methods_h")}</h2>
        <p class="block__sub">{t(lang, "home.methods_sub")}</p>
      </header>
      <ul class="methods-strip">
        {topMethods.map((m) => {
          const c = counts[m.category_id] || 0;
          const name = lang === "zh" ? m.name_zh : m.name_en;
          return (
            <li class="methods-strip__item">
              <a href={`${langPrefix}/methodology#${m.id}`} class="methods-strip__link">
                <span class="methods-strip__name">{name}</span>
                <span class="methods-strip__count mono tnum">{c}</span>
              </a>
            </li>
          );
        })}
      </ul>
      <p class="block__more">
        <a href={`${langPrefix}/methodology`}>{t(lang, "home.methods_more")}</a>
      </p>
    </div>
  </section>

  <section class="block block--alt" id="severity" aria-labelledby="severity-h">
    <div class="container">
      <header class="block__head">
        <p class="block__eyebrow">02 / severity</p>
        <h2 id="severity-h" class="block__h h-section">{t(lang, "home.severity_h")}</h2>
        <p class="block__sub">{t(lang, "home.severity_sub")}</p>
      </header>
      <SeverityLegend lang={lang} />
    </div>
  </section>

  <section class="block" id="featured" aria-labelledby="featured-h">
    <div class="container">
      <header class="block__head">
        <p class="block__eyebrow">03 / evidence</p>
        <h2 id="featured-h" class="block__h h-section">{t(lang, "home.featured_h")}</h2>
        <p class="block__sub">{t(lang, "home.featured_sub")}</p>
      </header>
      <div class="block__grid block__grid--3">
        {featured.map((m) => <FeaturedCaseCard mod={m} lang={lang} />)}
      </div>
      <p class="block__more">
        <a href={`${langPrefix}/cases`}>{lang === "zh" ? "看全部 13 个案例 →" : "see all 13 cases →"}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .block { padding: 3.5rem 0; }
  .block--alt { background: var(--bg-soft); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .block__head { max-width: 64ch; margin-bottom: 1.6rem; }
  .block__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 0.65rem 0;
  }
  .block__h {
    font-size: clamp(1.4rem, 2.8vw, 1.95rem);
    margin: 0 0 0.55rem 0;
  }
  .block__sub {
    font-family: var(--font-sans);
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }
  :lang(zh) .block__sub { font-family: var(--font-cjk); line-height: 1.75; }

  .block__grid { display: grid; gap: 1rem; }
  .block__grid--3 { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 980px) { .block__grid--3 { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .block__grid--3 { grid-template-columns: 1fr; } }

  .block__more {
    margin: 1.4rem 0 0 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }
  :lang(zh) .block__more { font-family: var(--font-cjk); }
  .block__more a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .block__more a:hover { color: var(--accent-deep); }

  .methods-strip {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  @media (max-width: 760px) { .methods-strip { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .methods-strip { grid-template-columns: 1fr; } }
  .methods-strip__item { background: var(--bg); }
  .methods-strip__link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1rem 1.1rem;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-sans);
    transition: background 120ms ease, color 120ms ease;
  }
  :lang(zh) .methods-strip__link { font-family: var(--font-cjk); }
  .methods-strip__link:hover, .methods-strip__link:focus-visible {
    background: var(--bg-raised);
    color: var(--accent);
  }
  .methods-strip__name { font-size: 0.95rem; font-weight: 500; }
  .methods-strip__count {
    font-weight: 700;
    color: var(--accent);
    font-size: 1.1rem;
  }
</style>
