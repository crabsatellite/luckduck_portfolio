---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import ActivityFeed from "~/components/ActivityFeed.astro";
import ModCard from "~/components/ModCard.astro";
import { sortedMods } from "~/lib/data";
import { t } from "~/i18n/strings";

const lang = "zh" as const;
const list = sortedMods();
---

<BaseLayout title="LUCK666DUCK" lang={lang}>
  <Hero lang={lang} />

  <section class="block" aria-labelledby="activity-h">
    <div class="container">
      <h2 id="activity-h" class="block__h">{t(lang, "home.activity_h")}</h2>
      <ActivityFeed lang={lang} />
    </div>
  </section>

  <section class="block" aria-labelledby="cases-h">
    <div class="container">
      <h2 id="cases-h" class="block__h">{t(lang, "home.cases_h")}</h2>
      <div class="cases-grid">
        {list.map((m) => <ModCard mod={m} lang={lang} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .block { padding: 2.4rem 0; }
  .block + .block { border-top: 1px solid var(--rule); }
  .block__h {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.78rem;
    color: var(--ink-mute);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.2rem 0;
  }
  :lang(zh) .block__h {
    font-family: var(--font-cjk);
    letter-spacing: 0.1em;
  }
  .cases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1rem;
  }
  @media (max-width: 540px) {
    .cases-grid { grid-template-columns: 1fr; }
  }
</style>
