---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import ModCard from "~/components/ModCard.astro";
import { sortedMods } from "~/lib/data";
import { t } from "~/i18n/strings";

const lang = "zh" as const;
const list = sortedMods();
---

<BaseLayout title="LUCK666DUCK" lang={lang}>
  <Hero lang={lang} />

  <section class="cases-section" id="all-mods" aria-labelledby="cases-heading">
    <div class="container">
      <header class="cases-section__head">
        <h2 id="cases-heading" class="cases-section__h h-section">{t(lang, "cases.title")}</h2>
        <p class="cases-section__sub">{t(lang, "cases.subtitle")}</p>
      </header>
      <div class="cases-grid">
        {list.map((m) => <ModCard mod={m} lang={lang} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cases-section { padding: 1.4rem 0 3rem 0; }
  .cases-section__head { padding: 1rem 0; }
  .cases-section__h {
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    margin: 0 0 0.5rem 0;
  }
  .cases-section__sub {
    font-family: var(--font-sans);
    color: var(--ink-mute);
    font-size: 0.95rem;
    margin: 0;
  }
  :lang(zh) .cases-section__sub { font-family: var(--font-cjk); }
  .cases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1rem;
    padding-top: 1.4rem;
  }
  @media (max-width: 540px) {
    .cases-grid { grid-template-columns: 1fr; }
  }
</style>
