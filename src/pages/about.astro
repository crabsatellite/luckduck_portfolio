---
import BaseLayout from "~/layouts/BaseLayout.astro";
import MascotDuck from "~/components/MascotDuck.astro";
import SteamDivider from "~/components/SteamDivider.astro";
import { t } from "~/i18n/strings";

const lang = "zh" as const;
---

<BaseLayout title={t(lang, "about.title")} lang={lang}>
  <article class="about">
    <div class="container">
      <header class="about__head">
        <MascotDuck size={96} alt="" blink={true} />
        <div>
          <h1 class="about__greet h-display">{t(lang, "about.greeting")}</h1>
          <p class="about__role">{t(lang, "about.role")}</p>
        </div>
      </header>
      <SteamDivider variant="compact" />
      <div class="about__body">
        <p>{t(lang, "about.zh_para1")}</p>
        <p>{t(lang, "about.zh_para2")}</p>
        <p>{t(lang, "about.zh_para3")}</p>
        <p>{t(lang, "about.zh_para4")}</p>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .about { padding: 2.4rem 0 3rem 0; }
  .about__head {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    padding: 1rem 0 1.4rem 0;
    flex-wrap: wrap;
  }
  .about__greet {
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    margin: 0 0 0.4rem 0;
  }
  .about__role {
    font-family: var(--font-sans);
    color: var(--ink-mute);
    font-size: 0.95rem;
    margin: 0;
    letter-spacing: 0.02em;
  }
  :lang(zh) .about__role { font-family: var(--font-cjk); }
  .about__body {
    max-width: 64ch;
    padding: 1.4rem 0;
    color: var(--ink);
  }
  .about__body p {
    margin: 0 0 1.2rem 0;
    font-size: 1rem;
  }
</style>
