---
import BaseLayout from "~/layouts/BaseLayout.astro";
import TestLogHeader from "~/components/TestLogHeader.astro";
import TestLog from "~/components/TestLog.astro";
import BugLedger from "~/components/BugLedger.astro";
import MembersPanel from "~/components/MembersPanel.astro";
import {
  mods, bugsForMod, isCredited, hasRegression, hasNoIssues,
  logNumber, getMcmodEntry, teamForMod, featuredBug,
  modCategoryBreakdown, methodFor, sceneForMod,
} from "~/lib/data";
import { t } from "~/i18n/strings";

export async function getStaticPaths() {
  return mods.map((m) => ({ params: { slug: m.id }, props: { mod: m } }));
}

const lang = "zh" as const;
const { mod } = Astro.props;
const bugs = bugsForMod(mod.id);
const credited = isCredited(mod);
const regress = hasRegression(mod);
const noIssues = hasNoIssues(mod);
const logNo = logNumber(mod);
const mcmod = getMcmodEntry(mod);
const team = teamForMod(mod);
const featured = featuredBug(mod);
const breakdown = modCategoryBreakdown(mod.id);
const scene = sceneForMod(mod);

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const langPrefix = base;
---

<BaseLayout title={mod.name_en} lang={lang}>
  <article class="case">
    <div class="container">
      <TestLogHeader
        mod={mod}
        logNo={logNo}
        totalBugs={mod.total_bugs}
        hasRegression={regress}
        isCredited={credited}
        hasNoIssues={noIssues}
        lang={lang}
      />

      {team.length > 0 && <MembersPanel team={team} lang={lang} />}

      {scene && (
        <figure class="case__scene">
          <img
            src={`${base}/scenes/${scene.file}`}
            alt={`${mod.name_en} ${t(lang, "case.scene_label")}`}
            width="1280"
            height="400"
            loading="eager"
          />
        </figure>
      )}

      <div class="case__layout">
        <div class="case__main">
          {mod.rounds.length > 1 && <TestLog rounds={mod.rounds} lang={lang} />}

          {noIssues ? (
            <section class="case__pass">
              <span class="case__pass-stamp stamp stamp--ok" aria-hidden="true">零 bug 通过</span>
              <h2 class="case__pass-title">{t(lang, "case.no_issues")}</h2>
              <p class="case__pass-detail">{t(lang, "case.no_issues_detail")}</p>
              <p class="case__pass-meta mono tnum">
                {mod.versions.join(" / ")} · 1 round
              </p>
            </section>
          ) : (
            <BugLedger bugs={bugs} featured={featured} lang={lang} />
          )}

          <section class="case__legend ledger-card" aria-labelledby="legend-heading">
            <h2 id="legend-heading" class="case__legend-h">{t(lang, "case.legend_title")}</h2>
            <p class="case__legend-intro">{t(lang, "case.legend_intro")}</p>
            <ul class="case__legend-list">
              <li><span class="pill" data-status="unfixed">unfixed</span> {t(lang, "case.legend_unfixed")}</li>
              <li><span class="pill" data-status="fixed">fixed</span> {t(lang, "case.legend_fixed")}</li>
              <li><span class="pill" data-status="noted-not-bug">noted</span> {t(lang, "case.legend_noted")}</li>
              <li><span class="chip" data-cat="crash">crash</span> {t(lang, "case.legend_crash_label")}</li>
            </ul>
          </section>
        </div>

        <aside class="case__side">
          {breakdown.length > 0 && (
            <div class="case__panel ledger-card">
              <p class="case__panel-h dateline">{t(lang, "case.sidebar_breakdown_h")}</p>
              <ul class="case__breakdown">
                {breakdown.map(({ cat, count }) => {
                  const m = methodFor(cat);
                  const name = m ? (lang === "zh" ? m.name_zh : m.name_en) : cat;
                  return (
                    <li>
                      <a href={`${langPrefix}/methodology#${m?.id ?? cat}`} class="case__breakdown-row">
                        <span class="case__breakdown-name">{name}</span>
                        <span class="mono tnum case__breakdown-n">{count}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          )}

          {mod.depth_signals.length > 0 && (
            <div class="case__panel ledger-card">
              <p class="case__panel-h dateline">{t(lang, "case.sidebar_signals_h")}</p>
              <ul class="case__signals">
                {mod.depth_signals.map((s) => <li><span class="chip">{s}</span></li>)}
              </ul>
            </div>
          )}

          {mcmod && (
            <div class="case__panel ledger-card">
              <p class="case__panel-h dateline">{t(lang, "case.sidebar_mcmod_h")}</p>
              <dl class="case__dl">
                {mcmod.loader && (<><dt>loader</dt><dd class="mono">{mcmod.loader}</dd></>)}
                {mcmod.status && (<><dt>status</dt><dd>{mcmod.status}</dd></>)}
                {mcmod.environment && (<><dt>env</dt><dd>{mcmod.environment}</dd></>)}
              </dl>
            </div>
          )}

          <div class="case__panel ledger-card">
            <p class="case__panel-h dateline">{t(lang, "case.sidebar_links_h")}</p>
            <ul class="case__links">
              {mod.mcmod_url ? (
                <li>
                  <a href={mod.mcmod_url} rel="noopener" target="_blank">
                    {t(lang, "case.mcmod_link")} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ) : (
                <li class="case__links-empty">{t(lang, "case.no_mcmod")}</li>
              )}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .case { padding: 0 0 3rem 0; }
  .case__layout {
    display: grid;
    grid-template-columns: minmax(0, 9fr) minmax(280px, 3.2fr);
    gap: clamp(1.8rem, 3.5vw, 2.6rem);
    margin-top: clamp(1.2rem, 2.5vw, 1.8rem);
    align-items: start;
  }
  @media (max-width: 980px) {
    .case__layout { grid-template-columns: 1fr; }
  }
  .case__main { min-width: 0; }

  /* ---- scene preview ----------------------------------- */
  .case__scene {
    margin: 1.2rem 0 1.6rem 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-soft);
    box-shadow:
      0 1px 0 color-mix(in oklch, var(--accent-deep) 14%, transparent),
      0 18px 28px -22px rgba(0, 0, 0, 0.55);
  }
  .case__scene img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 5;
    object-fit: cover;
  }

  /* ---- sidebar ----------------------------------------- */
  .case__side {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    position: sticky;
    top: 5rem;
  }
  @media (max-width: 980px) {
    .case__side { position: static; }
  }
  .case__panel {
    padding: 1.05rem 1.2rem 1.15rem 1.2rem;
    border-radius: var(--radius-lg);
  }
  .case__panel-h {
    margin: 0 0 0.7rem 0;
    color: var(--accent);
    font-size: 0.86rem;
    letter-spacing: 0.18em;
    line-height: 1;
  }
  :lang(zh) .case__panel-h { letter-spacing: 0.06em; }

  /* ---- depth signals ----------------------------------- */
  .case__signals { list-style: none; padding: 0; margin: 0; }
  .case__signals li { display: inline-block; margin: 0.16rem 0.2rem 0.16rem 0; }

  /* ---- category breakdown ------------------------------ */
  .case__breakdown { list-style: none; padding: 0; margin: 0; }
  .case__breakdown li { border-bottom: 1px dotted var(--rule); }
  .case__breakdown li:last-child { border-bottom: 0; }
  .case__breakdown-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.55rem 0;
    text-decoration: none;
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: 0.92rem;
    transition: color 140ms ease, padding-left 140ms ease;
  }
  :lang(zh) .case__breakdown-row { font-family: var(--font-cjk); }
  .case__breakdown-row:hover {
    color: var(--accent);
    padding-left: 0.3rem;
  }
  .case__breakdown-n {
    color: var(--accent);
    font-weight: 700;
    font-size: 1rem;
    font-family: var(--font-mono);
  }

  /* ---- mcmod definition list ---------------------------- */
  .case__dl {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0.45rem 0.8rem;
    margin: 0;
    font-size: 0.88rem;
  }
  .case__dl dt {
    color: var(--ink-mute);
    letter-spacing: 0.1em;
    font-size: 0.72rem;
    text-transform: uppercase;
    font-family: var(--font-stamp);
    line-height: 1.5;
  }
  :lang(zh) .case__dl dt {
    font-family: var(--font-stamp), var(--font-cjk);
    text-transform: none;
    letter-spacing: 0.04em;
    font-size: 0.78rem;
  }
  .case__dl dd { margin: 0; color: var(--ink); }
  :lang(zh) .case__dl dd { font-family: var(--font-cjk); }

  /* ---- links list -------------------------------------- */
  .case__links { list-style: none; margin: 0; padding: 0; }
  .case__links li { margin-bottom: 0.45rem; }
  .case__links a {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
  }
  :lang(zh) .case__links a { font-family: var(--font-cjk); }
  .case__links a:hover, .case__links a:focus-visible {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .case__links-empty {
    color: var(--ink-mute);
    font-size: 0.85rem;
    font-family: var(--font-sans);
  }
  :lang(zh) .case__links-empty { font-family: var(--font-cjk); }

  /* ---- clean-pass banner -------------------------------- */
  .case__pass {
    position: relative;
    border: 1px solid color-mix(in oklch, var(--ok) 35%, var(--rule));
    border-left: 5px solid var(--ok);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(180deg,
        color-mix(in oklch, var(--ok) 8%, var(--bg-soft)) 0%,
        var(--bg-soft) 100%);
    padding: 1.8rem 1.8rem 1.6rem 1.8rem;
    margin: 1.6rem 0 2rem 0;
    overflow: hidden;
  }
  .case__pass-stamp {
    position: absolute;
    top: 1rem;
    right: 1rem;
    transform: rotate(-6deg);
    box-shadow: 3px 3px 0 color-mix(in oklch, var(--ok-deep) 60%, transparent);
  }
  .case__pass-title {
    margin: 0 0 0.5rem 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
    color: var(--ok);
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  :lang(zh) .case__pass-title {
    font-family: var(--font-cjk);
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0;
  }
  .case__pass-detail {
    color: var(--ink);
    margin: 0 0 0.5rem 0;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 60ch;
  }
  :lang(zh) .case__pass-detail { font-family: var(--font-cjk); line-height: 1.85; }
  .case__pass-meta {
    color: var(--ink-mute);
    font-size: 0.85rem;
  }

  /* ---- legend ------------------------------------------- */
  .case__legend {
    margin: 1.8rem 0 0 0;
    padding: 1.3rem 1.5rem 1.45rem 1.5rem;
    border-radius: var(--radius-lg);
  }
  .case__legend-h {
    margin: 0 0 0.55rem 0;
    font-family: var(--font-stamp);
    color: var(--accent);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.88rem;
    line-height: 1;
  }
  :lang(zh) .case__legend-h {
    font-family: var(--font-stamp), var(--font-cjk);
    letter-spacing: 0.06em;
    text-transform: none;
  }
  .case__legend-intro {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    color: var(--ink-soft);
    line-height: 1.7;
    margin: 0 0 1rem 0;
    max-width: 64ch;
  }
  :lang(zh) .case__legend-intro { font-family: var(--font-cjk); line-height: 1.85; }
  .case__legend-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    color: var(--ink-soft);
    font-size: 0.88rem;
    font-family: var(--font-sans);
  }
  :lang(zh) .case__legend-list { font-family: var(--font-cjk); }
  .case__legend-list li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
</style>
