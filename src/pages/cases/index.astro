---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Filters from "~/components/Filters.astro";
import ModCard from "~/components/ModCard.astro";
import PageHead from "~/components/PageHead.astro";
import { mods, profile, sortedMods, totalBugs, totalRounds } from "~/lib/data";
import { t } from "~/i18n/strings";

const lang = "zh" as const;
const list = sortedMods();
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const langPrefix = base;

const indexStats = [
  { label: t(lang, "cases.index_total"), value: mods.length },
  { label: t(lang, "cases.index_bugs"), value: totalBugs(), accent: true },
  { label: t(lang, "cases.index_rounds"), value: totalRounds() },
  { label: t(lang, "cases.index_credits"), value: profile.curseforge.tester_credits.length },
];
---

<BaseLayout title={t(lang, "cases.title")} lang={lang}>
  <article class="cases-page">
    <div class="container">
      <PageHead
        lang={lang}
        mark="02"
        kicker={t(lang, "cases.kicker")}
        title={t(lang, "cases.title")}
        sub={t(lang, "cases.subtitle")}
        deck={t(lang, "cases.deck")}
      />

      <!-- ============ Department index strip ================== -->
      <section class="cases-index" aria-label="department totals" data-reveal>
        <header class="cases-index__head">
          <h2 class="cases-index__h">{t(lang, "cases.index_h")}</h2>
          <a class="cases-index__note-link" href={`${langPrefix}/about`}>
            {t(lang, "cases.note_link")}
          </a>
        </header>
        <dl class="cases-index__stats">
          {indexStats.map((s) => (
            <div class={`cases-index__stat ${s.accent ? "cases-index__stat--accent" : ""}`}>
              <dt>{s.label}</dt>
              <dd class="fancy-num mono tnum">{s.value}</dd>
            </div>
          ))}
        </dl>
        <p class="cases-index__note">{t(lang, "cases.note_p")}</p>
      </section>

      <Filters lang={lang} />

      <div class="cases-grid" data-reveal>
        {list.map((m, i) => <ModCard mod={m} lang={lang} index={i + 1} />)}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .cases-page { padding: 0 0 3rem 0; }

  /* ---- department index: 4-stat strip + note --------------- */
  .cases-index {
    margin: 0 0 clamp(1.4rem, 3vw, 2rem) 0;
    padding: clamp(1.4rem, 3vw, 2rem) 0;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }
  .cases-index__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 1.1rem;
  }
  .cases-index__h {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  :lang(zh) .cases-index__h {
    font-family: var(--font-cjk);
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0;
  }
  .cases-index__note-link {
    font-family: var(--font-sans);
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    font-size: 0.92rem;
    font-weight: 600;
    white-space: nowrap;
  }
  :lang(zh) .cases-index__note-link { font-family: var(--font-cjk); }
  .cases-index__note-link:hover { color: var(--accent-deep); }

  .cases-index__stats {
    margin: 0 0 1rem 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .cases-index__stat {
    margin: 0;
    padding: 1rem 1.1rem 1.1rem 1.1rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--bg-soft);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    position: relative;
  }
  .cases-index__stat::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--rule);
  }
  .cases-index__stat--accent::before { background: var(--accent); }
  .cases-index__stat dt {
    font-family: var(--font-stamp);
    color: var(--ink-mute);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0;
    order: 2;
  }
  :lang(zh) .cases-index__stat dt {
    font-family: var(--font-stamp), var(--font-cjk);
    letter-spacing: 0.04em;
    text-transform: none;
    font-size: 0.82rem;
  }
  .cases-index__stat dd {
    margin: 0;
    color: var(--ink);
    font-size: 2rem;
    line-height: 0.9;
    order: 1;
  }
  .cases-index__stat--accent dd { color: var(--accent); }
  .cases-index__note {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.7;
    max-width: 64ch;
  }
  :lang(zh) .cases-index__note {
    font-family: var(--font-cjk);
    line-height: 1.85;
  }

  /* ---- cases grid: dense newsprint TOC --------------------- */
  .cases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1rem;
    padding-top: clamp(0.6rem, 1.5vw, 1rem);
  }
  /* ModCard already brings its own border-radius/shadow; the
     index gets a tighter spacing so the page reads as a real
     catalog of entries rather than featured tiles. */
  @media (max-width: 540px) {
    .cases-grid { grid-template-columns: 1fr; }
    .cases-index__stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 380px) {
    .cases-index__stats { grid-template-columns: 1fr; }
  }
</style>
