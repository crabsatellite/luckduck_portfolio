---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Filters from "~/components/Filters.astro";
import ModCard from "~/components/ModCard.astro";
import { sortedMods } from "~/lib/data";
import { t } from "~/i18n/strings";

const lang = "zh" as const;
const list = sortedMods();
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const langPrefix = base;
---

<BaseLayout title={t(lang, "cases.title")} lang={lang}>
  <section class="cases-page">
    <div class="container">
      <header class="cases-page__head">
        <p class="eyebrow"><strong>cases</strong></p>
        <h1 class="cases-page__title h-display">{t(lang, "cases.title")}</h1>
        <p class="cases-page__sub">{t(lang, "cases.subtitle")}</p>
        <p class="cases-page__note">
          想找人测试自己的 MOD，建议先看公开署名和多轮回归案例，再到
          <a href={`${langPrefix}/about`}>关于页</a>
          看合作说明。
        </p>
      </header>
      <Filters lang={lang} />
      <div class="cases-grid">
        {list.map((m) => <ModCard mod={m} lang={lang} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cases-page { padding: 2.4rem 0 2rem 0; }
  .cases-page__head { margin-bottom: 1rem; max-width: 64ch; }
  .cases-page__title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 0.4rem 0 0.4rem 0;
  }
  .cases-page__sub {
    font-family: var(--font-sans);
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin: 0;
  }
  .cases-page__note {
    font-family: var(--font-cjk);
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.75;
    margin: 0.7rem 0 0 0;
  }
  .cases-page__note a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  :lang(zh) .cases-page__sub { font-family: var(--font-cjk); }
  .cases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1rem;
    padding-top: 0.6rem;
  }
  @media (max-width: 540px) {
    .cases-grid { grid-template-columns: 1fr; }
  }
</style>
