---
import BaseLayout from "~/layouts/BaseLayout.astro";
import MethodologyTable from "~/components/MethodologyTable.astro";
import { t } from "~/i18n/strings";

const lang = "zh" as const;
---

<BaseLayout title={t(lang, "methods.title")} lang={lang}>
  <article class="page">
    <div class="container">
      <header class="page__head">
        <p class="eyebrow"><strong>categories</strong></p>
        <h1 class="page__title h-display">{t(lang, "methods.title")}</h1>
        <p class="page__sub">{t(lang, "methods.subtitle")}</p>
      </header>

      <MethodologyTable lang={lang} />
    </div>
  </article>
</BaseLayout>

<style>
  .page { padding: 2.4rem 0 3rem 0; }
  .page__head { max-width: 64ch; margin-bottom: 1.4rem; }
  .page__title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 0.4rem 0 0.6rem 0;
  }
  .page__sub {
    font-family: var(--font-sans);
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.65;
    margin: 0;
  }
  :lang(zh) .page__sub { font-family: var(--font-cjk); line-height: 1.75; }
</style>
