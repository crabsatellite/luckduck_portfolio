---
import "~/styles/global.css";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import { langFromPath, t, type Lang } from "~/i18n/strings";

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const detected = langFromPath(Astro.url.pathname.replace(base, "") || "/");
const { title, description, lang = detected } = Astro.props;

const fullTitle = title === "LUCK666DUCK"
  ? "LUCK666DUCK · Minecraft mod QA tester"
  : `${title} · LUCK666DUCK`;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const htmlLang = lang === "en" ? "en" : "zh-Hans-CN";

const fallbackDescription =
  lang === "en"
    ? "Hi, I'm Tingfeng (LUCK666DUCK) — Minecraft mod tester. 13 mods tested, 433 bugs filed, on 1.20.1 / 1.21.1, bilingual zh / en."
    : "嗨, 我是楊庭鳳 (LUCK666DUCK), 做 Minecraft mod 测试。已测 13 个 mod、提交 433 条 bug, 跑 1.20.1 / 1.21.1, 简体 / 繁中 / 日文 / English。";

const ogPath = `${base}/og.png`;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" href={`${base}/favicon-32.png`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
    <link rel="canonical" href={canonical} />

    <title>{fullTitle}</title>
    <meta name="description" content={description || fallbackDescription} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description || fallbackDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogPath, Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#1c1d2a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fdf6e3" media="(prefers-color-scheme: light)" />
  </head>
  <body>
    <a href="#main" class="skip-link">{t(lang, "nav.skip")}</a>
    <Nav lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
