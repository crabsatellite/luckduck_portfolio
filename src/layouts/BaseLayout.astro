---
import "~/styles/global.css";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import { langFromPath, t, type Lang } from "~/i18n/strings";

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const detected = langFromPath(Astro.url.pathname.replace(base, "") || "/");
const { title, description, lang = detected } = Astro.props;

const fullTitle = title === "LUCK666DUCK"
  ? "LUCK666DUCK · Minecraft mod QA tester"
  : `${title} · LUCK666DUCK`;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const htmlLang = lang === "en" ? "en" : "zh-Hans-CN";

const fallbackDescription =
  lang === "en"
    ? "LUCK666DUCK — Minecraft mod tester. github · curseforge."
    : "LUCK666DUCK — Minecraft mod tester. github · curseforge.";

const ogPath = `${base}/og.png`;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" href={`${base}/favicon-32.png`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
    <link rel="canonical" href={canonical} />

    <title>{fullTitle}</title>
    <meta name="description" content={description || fallbackDescription} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description || fallbackDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogPath, Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#1c1d2a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fdf6e3" media="(prefers-color-scheme: light)" />

    <script is:inline define:vars={{ siteBase: base || "" }}>
      // Browser-language preference: redirect first-time visitors to the language
      // they're most likely reading. Subsequent navigation via the lang toggle
      // overrides this — saved to localStorage so the choice sticks across sessions.
      (function () {
        try {
          var KEY = "luckduck.lang";
          var SESSION_KEY = "luckduck.lang.checked";
          if (sessionStorage.getItem(SESSION_KEY)) return;
          sessionStorage.setItem(SESSION_KEY, "1");

          var pref = localStorage.getItem(KEY);
          var path = location.pathname;
          var basePrefix = siteBase || "";
          var rest = basePrefix && path.indexOf(basePrefix) === 0
            ? path.slice(basePrefix.length) : path;
          if (!rest || rest.charAt(0) !== "/") rest = "/" + rest;
          var isOnEn = /^\/en(\/|$)/.test(rest);

          if (!pref) {
            var langs = navigator.languages && navigator.languages.length
              ? navigator.languages : [navigator.language || "en"];
            var prefersZh = langs.some(function (l) {
              return l && l.toLowerCase().indexOf("zh") === 0;
            });
            pref = prefersZh ? "zh" : "en";
            localStorage.setItem(KEY, pref);
          }

          var target = null;
          if (pref === "zh" && isOnEn) {
            target = rest.replace(/^\/en(\/|$)/, "/");
          } else if (pref === "en" && !isOnEn) {
            target = rest === "/" ? "/en/" : "/en" + rest;
          }
          if (target) {
            location.replace(basePrefix + target + location.search + location.hash);
          }
        } catch (e) { /* no storage / private mode → no-op */ }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{t(lang, "nav.skip")}</a>
    <Nav lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
